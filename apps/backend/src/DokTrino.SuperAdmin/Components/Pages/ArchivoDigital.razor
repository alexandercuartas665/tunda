@page "/archivo-central"
@page "/archivo-digital"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Security.Claims
@using DokTrino.Application.Tenancy
@inject IArchivoDigitalService Arch
@inject IExpedienteService Exp

<PageTitle>Archivo Central - Archimente</PageTitle>

<div class="ec-head">
    <div class="ec-eyebrow">Archivo central &middot; Modulo expedientes</div>
    <h1 class="ec-title">Radicacion y expedientes</h1>
    <p class="ec-sub">Toda carga se clasifica contra la TRD activa por serie, subserie y tipologia. Ese conjunto se radica como un expediente con numero consecutivo, autor y fecha; luego se consulta, se le agregan documentos y se versionan.</p>
</div>

@* --- Pestanas Expedientes / Archivo Central --- *@
<div class="tcl-tabs">
    <button class="tcl-tab @(_vista == "expedientes" ? "on" : "")" @onclick='() => _vista = "expedientes"'>
        &#128193; Expedientes <span class="badge2">@_expedientes.Count</span>
    </button>
    <button class="tcl-tab @(_vista == "central" ? "on" : "")" @onclick="VerCentral">
        &#128451; Archivo Central
    </button>
</div>

@if (_error is not null) { <div class="ase-alert">@_error</div> }
@if (_ok is not null) { <div class="ase-ok">@_ok</div> }

@if (_vista == "expedientes")
{
    <div class="ec-tiles">
        <div class="ec-tile"><div class="k">Expedientes</div><div class="v">@_expedientes.Count</div><div class="m">en la TRD activa</div></div>
        <div class="ec-tile"><div class="k">Documentos</div><div class="v">@_expedientes.Sum(x => x.Documentos)</div><div class="m">radicados y versionados</div></div>
        <div class="ec-tile"><div class="k">Completitud media</div><div class="v">@CompletitudMedia()<small>%</small></div><div class="m">tipologias cubiertas</div></div>
        <div class="ec-tile accent"><div class="k">TRD activa</div><div class="v mono" style="font-size:19px;margin-top:10px;">@(_trdActivoTitulo ?? "Sin TRD activa")</div><div class="m">transaccion vigente</div></div>
    </div>

    <div class="ec-toolbar">
        <h2>Expedientes</h2>
        <span class="ec-count">@Filtrados().Count radicado(s)</span>
        <div class="ec-search">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none"><circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.6"/><path d="m11 11 3 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            <input placeholder="Buscar por radicado, nombre o serie" @bind="_expFiltro" @bind:event="oninput" />
        </div>
        <button class="trx-btn ghost" @onclick="AbrirCfgRad" title="Configurar el numero de radicado">&#9881; Radicado</button>
        <button class="trx-btn" @onclick="AbrirWizard">+ Nuevo expediente</button>
    </div>

    @if (_expedientes.Count == 0)
    {
        <div class="ec-card"><div class="trx-empty" style="padding:40px 20px;">Aun no hay expedientes radicados. Pulsa <strong>+ Nuevo expediente</strong> para radicar el primero.</div></div>
    }
    else
    {
        <div class="ec-card">
            <div class="ec-table-scroll">
                <table class="ec-table">
                    <thead>
                        <tr><th>Radicado</th><th>Expediente</th><th>Serie</th><th>Dependencia</th><th style="text-align:center">Docs</th><th style="text-align:center">Completitud</th><th>Fecha</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Filtrados())
                        {
                            <tr @onclick="() => AbrirExpediente(e)">
                                <td><span class="ec-rad">@e.Codigo</span></td>
                                <td class="ec-name">@e.Nombre</td>
                                <td class="ec-muted2">@(e.Serie ?? "-")</td>
                                <td class="ec-muted2">@(e.Dependencia ?? "-")</td>
                                <td style="text-align:center">@e.Documentos</td>
                                <td>
                                    <div style="display:flex;align-items:center;gap:9px;justify-content:center">
                                        <span class="ec-ring" style="--p:@e.Pct;--rc:@RingColor(e.Pct)"><i>@e.Pct</i></span>
                                        @if (e.Total > 0 && e.Pct >= 100) { <span class="ec-chip ok">Completo</span> }
                                        else if (e.Total > 0) { <span class="ec-chip warn">@e.Cubiertos/@e.Total</span> }
                                        else { <span class="ec-chip pend">Sin docs</span> }
                                    </div>
                                </td>
                                <td class="ec-muted2">@e.FechaApertura.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Filtrados().Count == 0) { <div class="trx-empty" style="padding:28px 20px;">Ningun expediente coincide con la busqueda.</div> }
        </div>
    }
}

<style>
    .ec-head { margin-bottom: 4px; }
    .ec-eyebrow { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.16em; color:var(--primary); }
    .ec-title { font-size:26px; font-weight:800; letter-spacing:-.02em; color:var(--foreground); margin:6px 0 0; }
    .ec-sub { font-size:13.5px; color:var(--muted-foreground); margin:8px 0 0; max-width:70ch; }
    .ec-tiles { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin:18px 0; }
    .ec-tile { background:var(--card,#fff); border:1px solid var(--border); border-radius:14px; padding:16px 18px; box-shadow:var(--shadow-soft); }
    .ec-tile .k { font-size:10.5px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:var(--muted-foreground); }
    .ec-tile .v { font-size:30px; font-weight:800; letter-spacing:-.02em; line-height:1; margin-top:8px; color:var(--foreground); }
    .ec-tile .v small { font-size:15px; color:var(--muted-foreground); font-weight:700; }
    .ec-tile .m { font-size:12px; color:var(--muted-foreground); margin-top:6px; }
    .ec-tile.accent { background:var(--primary-soft); border-color:color-mix(in srgb, var(--primary) 24%, transparent); }
    .ec-tile.accent .v { color:var(--primary-deep,var(--primary)); }
    .ec-toolbar { display:flex; align-items:center; gap:12px; margin:20px 0 0; flex-wrap:wrap; }
    .ec-toolbar h2 { font-size:18px; font-weight:800; color:var(--foreground); margin:0; }
    .ec-count { font-size:13px; color:var(--muted-foreground); }
    .ec-search { margin-left:auto; position:relative; display:flex; align-items:center; }
    .ec-search svg { position:absolute; left:11px; color:var(--muted-foreground); }
    .ec-search input { font-size:14px; padding:9px 12px 9px 34px; border:1px solid var(--border); border-radius:10px; background:var(--card,#fff); color:var(--foreground); width:260px; max-width:46vw; }
    .ec-search input:focus { outline:none; border-color:var(--primary); box-shadow:0 0 0 2px var(--primary-tint); }
    .ec-card { background:var(--card,#fff); border:1px solid var(--border); border-radius:14px; box-shadow:var(--shadow-card); margin-top:14px; overflow:hidden; }
    .ec-table-scroll { overflow-x:auto; }
    table.ec-table { width:100%; border-collapse:collapse; min-width:760px; }
    table.ec-table th { text-align:left; font-size:10.5px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; color:var(--muted-foreground); padding:13px 16px; border-bottom:1px solid var(--border); background:var(--chrome-surface,#f4f2ea); }
    table.ec-table td { padding:13px 16px; border-bottom:1px solid var(--border); font-size:13.5px; vertical-align:middle; color:var(--foreground); }
    table.ec-table tr:last-child td { border-bottom:none; }
    table.ec-table tbody tr { cursor:pointer; }
    table.ec-table tbody tr:hover { background:var(--primary-soft); }
    .ec-rad { font-family:'JetBrains Mono','Consolas',monospace; font-size:12.5px; font-weight:600; color:var(--primary-deep,var(--primary)); }
    .ec-name { font-weight:700; }
    .ec-muted2 { color:var(--muted-foreground); font-size:12.5px; }
    .ec-ring { --p:0; width:34px; height:34px; border-radius:50%; display:grid; place-items:center; background:conic-gradient(var(--rc) calc(var(--p)*1%), var(--chrome-surface,#eef2f7) 0); }
    .ec-ring i { width:24px; height:24px; border-radius:50%; background:var(--card,#fff); display:grid; place-items:center; font-size:9.5px; font-weight:700; font-style:normal; font-family:'JetBrains Mono','Consolas',monospace; color:var(--foreground); }
    .ec-chip { font-size:11px; font-weight:600; padding:3px 9px; border-radius:999px; white-space:nowrap; }
    .ec-chip.ok { background:oklch(0.95 0.03 155); color:var(--success); }
    .ec-chip.warn { background:oklch(0.95 0.045 78); color:oklch(0.52 0.12 68); }
    .ec-chip.pend { background:var(--chrome-surface,#f1efe7); color:var(--chrome-muted,#9b9484); }
    @@media (max-width:820px) { .ec-tiles { grid-template-columns:repeat(2,1fr); } .ec-search { margin-left:0; width:100%; } .ec-search input { width:100%; max-width:none; } }

    /* Preview del configurador de radicado */
    .radpreview { font-family:'JetBrains Mono','Consolas',monospace; background:var(--chrome-surface,#f4f2ea); border:1px dashed var(--border); border-radius:10px; padding:11px 13px; color:var(--primary-deep,var(--primary)); font-size:16px; font-weight:600; letter-spacing:.03em; }

    /* Galeria del Archivo Central */
    .gal-head { display:flex; align-items:flex-start; gap:16px; flex-wrap:wrap; margin-bottom:14px; }
    .gal-title { font-size:18px; font-weight:800; color:var(--foreground); margin:4px 0 0; }
    .gal-sub { font-size:12.5px; color:var(--muted-foreground); margin:4px 0 0; max-width:60ch; }
    .gal-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(190px,1fr)); gap:14px; }
    .gal-item { display:flex; flex-direction:column; border:1px solid var(--border); border-radius:13px; overflow:hidden; background:var(--card,#fff); text-decoration:none; color:inherit; transition:box-shadow .15s, border-color .15s; }
    .gal-item:hover { box-shadow:var(--shadow-card); border-color:var(--primary); }
    .gal-thumb { height:118px; display:flex; align-items:center; justify-content:center; background:var(--chrome-surface,#f4f2ea); overflow:hidden; }
    .gal-thumb img { width:100%; height:100%; object-fit:cover; }
    .gal-thumb .gal-ext { font-family:'JetBrains Mono','Consolas',monospace; font-weight:700; font-size:16px; letter-spacing:.04em; color:var(--primary-deep,var(--primary)); background:var(--card,#fff); border:1px solid var(--border); border-radius:9px; padding:8px 12px; }
    .gal-thumb.t-pdf .gal-ext { color:oklch(0.55 0.2 25); }
    .gal-body { padding:11px 12px; display:flex; flex-direction:column; gap:7px; flex:1; }
    .gal-name { font-size:12.5px; font-weight:700; color:var(--foreground); line-height:1.3; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
    .gal-meta { display:flex; flex-wrap:wrap; gap:4px; }
    .gal-chip { font-size:10px; font-weight:600; font-family:'JetBrains Mono','Consolas',monospace; color:var(--primary-deep,var(--primary)); background:var(--primary-soft); padding:2px 6px; border-radius:6px; }
    .gal-chip.alt { font-family:inherit; color:var(--muted-foreground); background:var(--chrome-surface,#f4f2ea); }
    .gal-rowfoot { display:flex; align-items:center; justify-content:space-between; margin-top:auto; gap:6px; }
    .gal-date { font-size:10.5px; color:var(--muted-foreground); }
    @@media (max-width:820px) { .gal-grid { grid-template-columns:repeat(auto-fill,minmax(150px,1fr)); } }
</style>

@if (_wizOpen)
{
    <div class="wiz-scrim" @onclick="CerrarWizard"></div>
    <div class="wiz-modal" @onclick:stopPropagation="true">
        <div class="wiz-head">
            <div>
                <div class="wiz-title">Nuevo expediente</div>
                <div class="wiz-sub">@(_wizTrd is null ? "Sin TRD activo en la entidad" : $"TRD activo: {_wizTrd.Titulo}")</div>
            </div>
            <button class="wiz-x" @onclick="CerrarWizard">&#10005;</button>
        </div>

        <div class="wiz-steps">
            <div class="wiz-step @(_wizPaso == 1 ? "active" : _wizPaso > 1 ? "done" : "")"><span class="wiz-n">1</span>Datos</div>
            <div class="wiz-sep"></div>
            <div class="wiz-step @(_wizPaso == 2 ? "active" : _wizPaso > 2 ? "done" : "")"><span class="wiz-n">2</span>Serie</div>
            <div class="wiz-sep"></div>
            <div class="wiz-step @(_wizPaso == 3 ? "active" : "")"><span class="wiz-n">3</span>Documentos</div>
        </div>

        <div class="wiz-body">
            @if (_wizError is not null) { <div class="ase-alert">@_wizError</div> }

            @if (_wizPaso == 1)
            {
                <div class="wiz-field"><label>Nombre del expediente</label>
                    <input class="form-control" @bind="_wizNombre" placeholder="Contratacion vigencia 2026" /></div>
                <div class="wiz-row">
                    <div class="wiz-field"><label>Sede</label>
                        <select class="form-select" @bind="_wizSede">
                            @if (_wizSedes.Count == 0) { <option value="PRINCIPAL">PRINCIPAL</option> }
                            @foreach (var s in _wizSedes) { <option value="@s.Nombre">@s.Nombre</option> }
                        </select>
                    </div>
                    <div class="wiz-field"><label>Dependencia (opcional)</label>
                        <select class="form-select" @bind="_wizDepId">
                            <option value="">(sin dependencia)</option>
                            @foreach (var d in _wizDeps) { <option value="@d.Id">@d.Codigo - @d.Nombre</option> }
                        </select>
                    </div>
                </div>
                @if (_wizTrd is null)
                {
                    <div class="ase-alert" style="margin-top:10px;">No hay un TRD marcado ACTIVO. Activalo en Transacciones para poder elegir series caracterizadas.</div>
                }
            }
            else if (_wizPaso == 2)
            {
                <div class="wiz-field"><label>Serie documental (del TRD activo)</label>
                    <input class="form-control" placeholder="Escribe para filtrar por codigo o nombre"
                           @bind="_wizSerieFiltro" @bind:event="oninput" />
                    <div class="combo-list">
                        @foreach (var s in SeriesFiltradas())
                        {
                            <button type="button" class="combo-item @(_wizSerieId == s.Id.ToString() ? "on" : "")" @onclick="() => SeleccionarSerie(s)">
                                <span class="mono">@s.Codigo</span> @s.Nombre
                            </button>
                        }
                        @if (_wizSeries.Count > 0 && SeriesFiltradas().Count == 0)
                        {
                            <div class="combo-empty">Ninguna serie coincide con la busqueda.</div>
                        }
                    </div>
                </div>
                @if (_wizSeries.Count == 0)
                {
                    <div class="ase-alert">El TRD activo no tiene series caracterizadas todavia.</div>
                }
                @if (_wizEstructura is not null)
                {
                    <div class="wiz-preview">
                        <div class="wiz-preview-h">Estructura de la serie</div>
                        @foreach (var sub in _wizEstructura.Subseries)
                        {
                            <div class="wiz-sub"><span class="mono">@sub.Codigo</span> @sub.Nombre <span class="wiz-count">@sub.Tipologias.Count tipologia(s)</span></div>
                        }
                        @if (_wizEstructura.TipologiasDirectas.Count > 0)
                        {
                            <div class="wiz-sub"><em>Tipologias directas</em> <span class="wiz-count">@_wizEstructura.TipologiasDirectas.Count</span></div>
                        }
                        @if (_wizEstructura.Subseries.Count == 0 && _wizEstructura.TipologiasDirectas.Count == 0)
                        {
                            <div class="text-muted">Esta serie no tiene subseries ni tipologias en el catalogo.</div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="wiz-created">Expediente <strong>@_wizExpCodigo</strong> creado. Sube el documento de cada tipologia.</div>

                @if (_wizEstructura is not null && (_wizEstructura.Subseries.Count + _wizEstructura.TipologiasDirectas.Count) > 6)
                {
                    <div class="wiz-field"><input class="form-control" placeholder="Filtrar tipologias" @bind="_wizTipFiltro" @bind:event="oninput" /></div>
                }
                @if (_wizEstructura is not null)
                {
                    @foreach (var sub in _wizEstructura.Subseries)
                    {
                        var tf = TipsFiltradas(sub.Tipologias, _wizTipFiltro);
                        if (tf.Count > 0)
                        {
                            <div class="wiz-group-h"><span class="mono">@sub.Codigo</span> @sub.Nombre</div>
                            @foreach (var tip in tf) { @RenderTipologia(tip) }
                        }
                    }
                    @if (TipsFiltradas(_wizEstructura.TipologiasDirectas, _wizTipFiltro).Count > 0)
                    {
                        <div class="wiz-group-h">Tipologias directas</div>
                        @foreach (var tip in TipsFiltradas(_wizEstructura.TipologiasDirectas, _wizTipFiltro)) { @RenderTipologia(tip) }
                    }
                }
            }
        </div>

        <div class="wiz-foot">
            @if (_wizPaso == 1)
            {
                <button class="btn btn-outline-secondary btn-sm" @onclick="CerrarWizard">Cancelar</button>
                <button class="trx-btn" disabled="@(string.IsNullOrWhiteSpace(_wizNombre))" @onclick="WizIrSerie">Siguiente</button>
            }
            else if (_wizPaso == 2)
            {
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => _wizPaso = 1">Atras</button>
                <button class="trx-btn" disabled="@(string.IsNullOrWhiteSpace(_wizSerieId) || _wizBusy)" @onclick="WizCrearExpediente">Crear expediente y continuar</button>
            }
            else
            {
                <span class="text-muted" style="margin-right:auto;">@_wizCargadas.Count documento(s) cargado(s)</span>
                <button class="trx-btn" @onclick="WizFinalizar">Finalizar</button>
            }
        </div>
    </div>
}

@* --- Configurador del numero de radicado --- *@
@if (_cfgRadOpen)
{
    <div class="wiz-scrim" @onclick="() => _cfgRadOpen = false"></div>
    <div class="wiz-modal" style="width:520px;" @onclick:stopPropagation="true">
        <div class="wiz-head">
            <div>
                <div class="wiz-title">Formato del radicado</div>
                <div class="wiz-sub">Como se arma el numero del expediente al radicar</div>
            </div>
            <button class="wiz-x" @onclick="() => _cfgRadOpen = false">&#10005;</button>
        </div>
        <div class="wiz-body">
            <div class="wiz-row">
                <div class="wiz-field"><label>Prefijo</label><input class="form-control" @bind="_cfgRad.Prefijo" @bind:event="oninput" placeholder="EXP" maxlength="12" /></div>
                <div class="wiz-field"><label>Separador</label><input class="form-control" @bind="_cfgRad.Separador" @bind:event="oninput" placeholder="-" maxlength="3" /></div>
            </div>
            <div class="wiz-row">
                <div class="wiz-field"><label>Longitud del consecutivo</label><input type="number" min="1" max="10" class="form-control" @bind="_cfgRad.LongitudConsecutivo" @bind:event="oninput" /></div>
                <div class="wiz-field"><label>Opciones</label>
                    <label class="ase-chk"><input type="checkbox" class="form-check-input" @bind="_cfgRad.IncluirAnio" /> Incluir el anio</label>
                    <label class="ase-chk"><input type="checkbox" class="form-check-input" @bind="_cfgRad.ReinicioAnual" /> Reiniciar consecutivo cada anio</label>
                </div>
            </div>
            <div class="wiz-field">
                <label>Vista previa</label>
                <div class="radpreview">@ExpedienteService.ConstruirRadicado(_cfgRad, DateTime.Now.Year, 1)</div>
                <p class="gal-sub" style="margin:4px 0 0;">Asi se vera el primer radicado del anio; el consecutivo sube con cada expediente.</p>
            </div>
        </div>
        <div class="wiz-foot">
            <button class="btn btn-outline-secondary btn-sm" @onclick="() => _cfgRadOpen = false">Cancelar</button>
            <button class="trx-btn" @onclick="GuardarCfgRad">Guardar formato</button>
        </div>
    </div>
}

<div class="ase-card gal-card" style="@(_vista == "central" ? "" : "display:none")">
    <div class="gal-head">
        <div style="flex:1;min-width:0;">
            <div class="ec-eyebrow">Archivo central &middot; Galeria</div>
            <h2 class="gal-title">Buscar documentos</h2>
            <p class="gal-sub">Todos los documentos de la empresa. Busca por nombre, identificador, tipologia o expediente.</p>
        </div>
        <div class="ec-search">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none"><circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.6"/><path d="m11 11 3 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            <input placeholder="Buscar documento..." @bind="_galFiltro" @bind:event="oninput" @bind:after="LoadGaleria" />
        </div>
    </div>
    @if (_galeria.Count == 0)
    {
        <div class="trx-empty" style="padding:34px 20px;">@(_galeriaCargada ? "No hay documentos que coincidan con la busqueda." : "Cargando documentos...")</div>
    }
    else
    {
        <div class="gal-grid">
            @foreach (var g in _galeria)
            {
                <a class="gal-item" href="@VisorUrl(g)" target="_blank" rel="noopener">
                    <div class="gal-thumb t-@g.Visor">
                        @if (g.Visor == "imagen")
                        {
                            <img src="@($"/archivo-digital/{g.Id}/contenido")" loading="lazy" alt="@g.Nombre" />
                        }
                        else
                        {
                            <span class="gal-ext">@ExtGal(g)</span>
                        }
                    </div>
                    <div class="gal-body">
                        <div class="gal-name" title="@g.Nombre">@g.Nombre</div>
                        <div class="gal-meta">
                            @if (g.ExpedienteCodigo is not null) { <span class="gal-chip">@g.ExpedienteCodigo</span> }
                            @if (g.Tipologia is not null) { <span class="gal-chip alt">@g.Tipologia</span> }
                            @if (g.IdentificadorPrincipal is not null) { <span class="gal-chip alt">@g.IdentificadorPrincipal</span> }
                        </div>
                        <div class="gal-rowfoot">
                            <span class="ad-badge ad-@g.EstadoAprobacion">@g.EstadoAprobacion</span>
                            <span class="gal-date">@g.FechaSubida.ToLocalTime().ToString("dd/MM/yyyy")</span>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</div>

<div class="ase-card" style="@(_vista == "central" ? "" : "display:none")">
    <div class="ase-card-h">Cargar documento</div>
    <div class="ad-form">
        <div class="ad-f ad-grow"><label>Archivo</label><InputFile class="form-control form-control-sm" OnChange="OnFile" /></div>
        <div class="ad-f ad-grow"><label>Nombre</label><input class="form-control form-control-sm" @bind="_n.Nombre" placeholder="Oficio 001" /></div>
        <div class="ad-f ad-grow"><label>Tipologia (opcional)</label>
            <select class="form-select form-select-sm" @bind="_nTip">
                <option value="">(sin identificar)</option>
                @foreach (var o in _tipos) { <option value="@o.Id">@o.Etiqueta</option> }
            </select>
        </div>
        <div class="ad-f"><label>&nbsp;</label><button class="btn btn-primary btn-sm" @onclick="Subir" disabled="@(_file is null)">Cargar</button></div>
    </div>
    <small class="text-muted">Si cargas sin tipologia, el documento entra a "Documentos sin Identificar". Todo documento nuevo queda PENDIENTE de aprobacion.</small>
</div>

<div class="ase-card" style="@(_vista == "central" ? "" : "display:none")">
    <div class="ase-tabs">
        <button class="ase-tab @(_bandeja == BandejaArchivo.Clasificados ? "on" : "")" @onclick="() => Cambiar(BandejaArchivo.Clasificados)">Archivos clasificados</button>
        <button class="ase-tab @(_bandeja == BandejaArchivo.SinIdentificar ? "on" : "")" @onclick="() => Cambiar(BandejaArchivo.SinIdentificar)">Documentos sin Identificar</button>
        <button class="ase-tab @(_bandeja == BandejaArchivo.SinAprobar ? "on" : "")" @onclick="() => Cambiar(BandejaArchivo.SinAprobar)">Documentos sin Aprobar</button>
    </div>

    <div class="ad-form">
        <div class="ad-f ad-grow"><label>Filtrar por identificador principal</label><input class="form-control form-control-sm" @bind="_filtroIdent" placeholder="cedula, contrato..." /></div>
        <div class="ad-f ad-grow"><label>Carpeta</label>
            <select class="form-select form-select-sm" @bind="_filtroCarpeta">
                <option value="">(todas)</option>
                @foreach (var c in _carpetas) { <option value="@c.Id">@c.Nombre (@c.Archivos)</option> }
            </select>
        </div>
        <div class="ad-f"><label>&nbsp;</label><button class="btn btn-outline-primary btn-sm" @onclick="Load">Filtrar</button></div>
    </div>

    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr><th>Documento</th><th>Identificador</th><th>Tipologia</th><th>Expediente</th><th>Tags</th><th>Estado</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var a in _items)
                {
                    <tr>
                        <td>@a.Nombre <span class="ad-muted">(@(a.SizeBytes / 1024) KB)</span></td>
                        <td>@(a.IdentificadorPrincipal ?? "-")</td>
                        <td>@(a.TipologiaNombre ?? "-")</td>
                        <td>
                            <select class="form-select form-select-sm" style="min-width:150px"
                                    @onchange="e => AsignarAExpediente(a.Id, e.Value?.ToString() ?? string.Empty)">
                                <option value="">(sin expediente)</option>
                                @foreach (var ex in _expedientes.Where(x => x.Estado == "ABIERTO"))
                                {
                                    <option value="@ex.Id">@ex.Codigo</option>
                                }
                            </select>
                        </td>
                        <td>@(string.IsNullOrEmpty(a.Tags) ? "-" : a.Tags)</td>
                        <td><span class="ad-badge ad-@a.EstadoAprobacion">@a.EstadoAprobacion</span></td>
                        <td class="ase-row-actions">
                            <button class="btn btn-outline-primary btn-sm" @onclick="() => Seleccionar(a)">Clasificar</button>
                            @if (a.EstadoAprobacion == "PENDIENTE")
                            {
                                <button class="btn btn-outline-success btn-sm" @onclick="() => Aprobar(a.Id)">Aprobar</button>
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => Rechazar(a.Id)">Rechazar</button>
                            }
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => Eliminar(a.Id)">&times;</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (_items.Count == 0) { <div class="ase-empty">Sin documentos en esta bandeja.</div> }
    </div>
</div>

@if (_sel is not null && _vista == "central")
{
    <div class="ase-card">
        <div class="ase-card-h">Clasificar: @_sel.Nombre</div>
        <div class="ad-form">
            <div class="ad-f ad-grow"><label>Identificador principal</label><input class="form-control form-control-sm" @bind="_cls.IdentificadorPrincipal" placeholder="1130597152" /></div>
            <div class="ad-f ad-grow"><label>Concepto</label><input class="form-control form-control-sm" @bind="_cls.Concepto" /></div>
            <div class="ad-f ad-grow"><label>Tipologia</label>
                <select class="form-select form-select-sm" @bind="_clsTip">
                    <option value="">(sin tipologia)</option>
                    @foreach (var o in _tipos) { <option value="@o.Id">@o.Etiqueta</option> }
                </select>
            </div>
            <div class="ad-f ad-grow"><label>Carpeta</label>
                <select class="form-select form-select-sm" @bind="_clsCarpeta">
                    <option value="">(sin carpeta)</option>
                    @foreach (var c in _carpetas) { <option value="@c.Id">@c.Nombre</option> }
                </select>
            </div>
            <div class="ad-f"><label>&nbsp;</label><button class="btn btn-primary btn-sm" @onclick="Clasificar">Guardar</button></div>
        </div>
        <div class="ad-form">
            <div class="ad-f ad-grow"><label>Asignar tag</label>
                <select class="form-select form-select-sm" @bind="_selTag">
