    .exp-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:14px; }
    .exp-card { background:#fff; border:1px solid #e9ecf5; border-radius:15px; padding:17px; cursor:pointer; box-shadow:0 1px 3px oklch(0.35 0.06 237 / .05); transition:box-shadow .15s; }
    .exp-card:hover { box-shadow:0 10px 26px oklch(0.35 0.06 237 / .12); }
    .exp-card-top { display:flex; align-items:center; gap:11px; margin-bottom:13px; }
    .exp-ico { width:42px; height:42px; border-radius:12px; background:var(--primary-soft); display:flex; align-items:center; justify-content:center; font-size:20px; flex-shrink:0; }
    .exp-name { font-size:14px; font-weight:700; color:#1f2433; line-height:1.3; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .exp-code { font-family:'IBM Plex Mono',monospace; font-size:11px; font-weight:600; color:var(--primary); margin-top:2px; }
    .exp-meta { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
    .exp-chip { font-size:10.5px; font-weight:600; color:#5a6378; background:#f4f6fb; border-radius:7px; padding:4px 9px; }
    .exp-docs { font-size:10.5px; font-weight:600; color:#8a93a8; }
    .exp-fecha { font-size:10.5px; font-weight:500; color:var(--chrome-label); margin-left:auto; }
    .exp-visor-item { display:flex; align-items:center; gap:8px; padding:9px 11px; border-radius:10px; cursor:pointer; font-size:12px; color:#37415c; }
    .exp-visor-item:hover { background:#f6f8fc; }
    .exp-visor-item.on { background:var(--primary-soft); color:var(--primary); font-weight:700; }
    .comp-wrap { margin-bottom:14px; }
    .comp-bar { height:9px; background:#eef2f7; border-radius:999px; overflow:hidden; }
    .comp-fill { height:100%; background:linear-gradient(90deg,#22c55e,#16a34a); border-radius:999px; transition:width .3s; }
    .comp-txt { font-size:12px; color:#475569; margin-top:5px; font-weight:600; }
    .doc-sub-h { font-size:12px; font-weight:800; color:#0f172a; margin:14px 0 6px; padding-bottom:4px; border-bottom:1px solid #eef2f7; }
    .doc-tip { margin:0 0 8px; }
    .doc-tip-h { font-size:13px; font-weight:600; color:#1f2433; margin:8px 0 4px; }
    .doc-count { font-size:10px; color:#64748b; background:#f1f5f9; padding:1px 7px; border-radius:999px; margin-left:6px; }
    .doc-fila { border:1px solid #eef2f7; border-radius:10px; padding:8px 10px; margin:5px 0; }
    .doc-fila-main { display:flex; align-items:center; gap:8px; }
    .doc-name { font-size:12.5px; font-weight:600; color:#1f2433; flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .doc-ver { font-size:10px; font-weight:700; color:#1e40af; background:#dbeafe; padding:1px 7px; border-radius:999px; }
    .doc-fila-act { display:flex; gap:6px; margin-top:6px; flex-wrap:wrap; align-items:center; }
    .doc-add { margin:4px 0 2px; }
    .doc-add-lbl { font-size:12px; color:var(--primary,#0288d1); cursor:pointer; font-weight:600; }
    .doc-vers { margin-top:8px; border-top:1px dashed #e2e8f0; padding-top:6px; }
    .doc-ver-row { display:flex; align-items:center; gap:10px; font-size:12px; padding:3px 0; }
    .btn-xs { padding:1px 8px; font-size:11.5px; line-height:1.5; }
    .visor-frame { width:100%; height:460px; border:1px solid var(--chrome-border,#e2e8f0); border-radius:12px; background:#fff; }
    .visor-img { max-width:100%; max-height:460px; border-radius:12px; border:1px solid var(--chrome-border,#e2e8f0); }
    /* Modal del expediente: .cfg-modal no estaba definida, por eso se renderizaba suelto al pie. */
    .cfg-modal { position:fixed; top:50%; left:50%; transform:translate(-50%,-50%); z-index:2000;
                 max-width:calc(100vw - 32px); max-height:88vh; display:flex; flex-direction:column;
                 background:#fff; border-radius:16px; box-shadow:0 30px 80px rgba(15,23,42,.35); overflow:hidden; }
    .cfg-modal-head { display:flex; align-items:flex-start; gap:12px; padding:16px 20px; border-bottom:1px solid #eef1f7; flex-shrink:0; }
    .cfg-modal-head .ttl { font-size:16px; font-weight:800; color:#1f2433; }
    .cfg-modal-head .sub { font-size:12px; color:#8a93ad; margin-top:2px; }
    .cfg-modal-head .cls { cursor:pointer; font-size:20px; color:#9aa3bd; line-height:1; user-select:none; }
    .cfg-modal-head .cls:hover { color:#5a6378; }
    .cfg-modal-body { padding:16px 20px; overflow:auto; }
</style>

@code {
    private const long MaxBytes = 20L * 1024 * 1024;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private List<ArchivoCentralDto> _items = new();
    private List<CarpetaArchivoDto> _carpetas = new();
    private List<TagDto> _tags = new();
    private List<OpcionDto> _tipos = new();
    private BandejaArchivo _bandeja = BandejaArchivo.Clasificados;
    private ArchivoCentralDto? _sel;
    private ClasificarRequest _cls = new();
    private SubirArchivoRequest _n = new();
    private IBrowserFile? _file;
    private string _nTip = "", _clsTip = "", _clsCarpeta = "", _selTag = "";
    private string _filtroIdent = "", _filtroCarpeta = "";
    private string _nuevaCarpeta = "", _nuevaCarpetaPadre = "";
    private string _nuevoTagCod = "", _nuevoTagNom = "";
    private bool _nuevoTagPriv;

    // --- Expedientes (Fase 2F) ---
    private string _vista = "expedientes";
    private List<ExpedienteDto> _expedientes = new();
    private ExpedienteDto? _expSel;
    // Detalle de expediente: estructura de la serie, documentos agrupados, completitud, visor.
    private string _expSubTab = "docs";
    private EstructuraSerieDto? _expEstructura;
    private List<DocExpDto> _expDocsGrp = new();
    private CompletitudDto? _expComp;
    private Guid? _verId;
    private string? _verMime;
    private string? _verNombre;
    private readonly HashSet<Guid> _versExpandido = new();
    private Guid? _subiendoTip;
    private Guid? _subiendoGrupo;
    private string _expSedeDefault = "PRINCIPAL";
    private string? _error, _ok;

    // --- Asistente de expediente (modal guiado desde el TRD activo) ---
    private bool _wizOpen;
    private int _wizPaso = 1;
    private string _wizNombre = "";
    private string _wizSede = "PRINCIPAL";
    private string _wizDepId = "";
    private string _wizSerieId = "";
    private TrdActivoDto? _wizTrd;
    private List<SerieExpDto> _wizSeries = new();
    private List<SedeExpDto> _wizSedes = new();
    private List<DependenciaExpDto> _wizDeps = new();
    private EstructuraSerieDto? _wizEstructura;
    private Guid? _wizExpId;
    private string _wizExpCodigo = "";
    private readonly HashSet<Guid> _wizCargadas = new();
    private Guid? _wizSubiendo;
    private bool _wizBusy;
    private string? _wizError;

    protected override async Task OnInitializedAsync()
    {
        await Load();
        await CargarExpedientes();
    }

    private async Task<Guid> Actor()
    {
        if (AuthState is null) { return Guid.Empty; }
        var st = await AuthState;
        return Guid.TryParse(st.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : Guid.Empty;
    }

    private async Task Load()
    {
        Guid? carpeta = Guid.TryParse(_filtroCarpeta, out var cf) ? cf : null;
        _items = (await Arch.ListarAsync(_bandeja, carpeta, _filtroIdent)).ToList();
        _carpetas = (await Arch.ListarCarpetasAsync()).ToList();
        _tags = (await Arch.ListarTagsAsync(await Actor())).ToList();
        _tipos = (await Arch.TipologiasParaSelectAsync()).ToList();
    }

    private async Task Cambiar(BandejaArchivo b) { _bandeja = b; _sel = null; await Load(); }

    private void OnFile(InputFileChangeEventArgs e)
    {
        _file = e.File;
        if (string.IsNullOrWhiteSpace(_n.Nombre)) { _n.Nombre = e.File.Name; }
        _n.Mime = string.IsNullOrWhiteSpace(e.File.ContentType) ? "application/octet-stream" : e.File.ContentType;
    }

    private async Task Subir()
    {
        _error = _ok = null;
        if (_file is null) { _error = "Elige un archivo."; return; }
        _n.TipologiaId = Guid.TryParse(_nTip, out var t) ? t : null;
        try
        {
            await using var stream = _file.OpenReadStream(MaxBytes);
            var saved = await Arch.SubirAsync(_n, stream, await Actor());
            if (saved is null) { _error = "Sin tenant activo."; return; }
            _ok = $"Documento '{saved.Nombre}' cargado ({saved.EstadoAprobacion}).";
            _n = new(); _file = null; _nTip = "";
            await Load();
        }
        catch (InvalidOperationException ex) { _error = ex.Message; }
    }

    private void Seleccionar(ArchivoCentralDto a)
    {
        _sel = a;
        _cls = new ClasificarRequest { ArchivoId = a.Id, IdentificadorPrincipal = a.IdentificadorPrincipal, Concepto = a.Concepto };
        _clsTip = a.TipologiaId?.ToString() ?? "";
        _clsCarpeta = a.CarpetaArchivoId?.ToString() ?? "";
    }

    private async Task Clasificar()
    {
        _error = _ok = null;
        _cls.TipologiaId = Guid.TryParse(_clsTip, out var t) ? t : null;
        _cls.CarpetaArchivoId = Guid.TryParse(_clsCarpeta, out var c) ? c : null;
        try { await Arch.ClasificarAsync(_cls, await Actor()); _ok = "Documento clasificado."; _sel = null; await Load(); }
        catch (InvalidOperationException ex) { _error = ex.Message; }
    }

    private async Task AsignarTag()
    {
        _error = _ok = null;
        if (_sel is null || !Guid.TryParse(_selTag, out var tid)) { _error = "Elige un tag."; return; }
        await Arch.AsignarTagAsync(_sel.Id, tid, await Actor());
        _ok = "Tag asignado."; _selTag = "";
        await Load();
    }

    private async Task Aprobar(Guid id)
    {
        _error = _ok = null;
        await Arch.AprobarAsync(id, null, await Actor());
        _ok = "Documento aprobado.";
        await Load();
    }

    private async Task Rechazar(Guid id)
    {
        _error = _ok = null;
        try { await Arch.RechazarAsync(id, "Rechazado desde la bandeja de aprobacion.", await Actor()); _ok = "Documento rechazado."; await Load(); }
        catch (InvalidOperationException ex) { _error = ex.Message; }
    }

    private async Task Eliminar(Guid id) { _error = _ok = null; await Arch.EliminarAsync(id, await Actor()); await Load(); }

    private async Task CrearCarpeta()
    {
        _error = _ok = null;
        Guid? padre = Guid.TryParse(_nuevaCarpetaPadre, out var p) ? p : null;
        try { await Arch.CrearCarpetaAsync(padre, _nuevaCarpeta, await Actor()); _nuevaCarpeta = ""; _nuevaCarpetaPadre = ""; await Load(); }
        catch (InvalidOperationException ex) { _error = ex.Message; }
    }

    private async Task CrearTag()
    {
        _error = _ok = null;
        try { await Arch.CrearTagAsync(_nuevoTagCod, _nuevoTagNom, null, _nuevoTagPriv, await Actor()); _nuevoTagCod = ""; _nuevoTagNom = ""; _nuevoTagPriv = false; await Load(); }
        catch (InvalidOperationException ex) { _error = ex.Message; }
    }

    // ---------------- Expedientes ----------------

    private async Task CargarExpedientes() => _expedientes = (await Exp.ListarAsync()).ToList();

    // ---------------- Asistente de expediente ----------------

    private async Task AbrirWizard()
    {
        _wizError = _error = _ok = null;
        _wizPaso = 1;
        _wizNombre = ""; _wizDepId = ""; _wizSerieId = "";
        _wizEstructura = null; _wizExpId = null; _wizExpCodigo = "";
        _wizCargadas.Clear(); _wizSubiendo = null;
        _wizTrd = await Exp.TrdActivoAsync();
        _wizSeries = (await Exp.SeriesDelTrdActivoAsync()).ToList();
        _wizSedes = (await Exp.SedesAsync()).ToList();
        _wizDeps = (await Exp.DependenciasDelTrdActivoAsync()).ToList();
        _wizSede = _wizSedes.FirstOrDefault()?.Nombre ?? "PRINCIPAL";
        _wizOpen = true;
    }

    private void CerrarWizard() => _wizOpen = false;

    private void WizIrSerie() { if (!string.IsNullOrWhiteSpace(_wizNombre)) { _wizError = null; _wizPaso = 2; } }

    private async Task OnWizSerie(ChangeEventArgs e)
    {
        _wizSerieId = e.Value?.ToString() ?? "";
        _wizEstructura = null;
        if (Guid.TryParse(_wizSerieId, out var sid)) { _wizEstructura = await Exp.EstructuraSerieAsync(sid); }
    }

    private async Task WizCrearExpediente()
    {
        _wizError = null;
        if (!Guid.TryParse(_wizSerieId, out var serieId)) { _wizError = "Selecciona una serie."; return; }
        _wizBusy = true;
        try
        {
            Guid? depId = Guid.TryParse(_wizDepId, out var d) ? d : null;
            var exp = await Exp.CrearAsync(new CrearExpedienteRequest { Nombre = _wizNombre, SerieId = serieId, DependenciaId = depId }, await Actor());
            if (exp is null) { _wizError = "No se pudo crear el expediente."; return; }
            _wizExpId = exp.Id; _wizExpCodigo = exp.Codigo; _wizPaso = 3;
            await CargarExpedientes();
        }
        catch (InvalidOperationException ex) { _wizError = ex.Message; }
        finally { _wizBusy = false; }
    }

    private async Task OnWizArchivo(InputFileChangeEventArgs e, TipologiaExpDto tip)
    {
        if (_wizExpId is not Guid expId) { return; }
        _wizError = null;
        _wizSubiendo = tip.Id;
        try
        {
            var file = e.File;
            var req = new SubirArchivoRequest
            {
                Sucursal = _wizSede,
                Nombre = $"{tip.Codigo} - {file.Name}",
                TipologiaId = tip.Id,
                Mime = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType
            };
            await using var stream = file.OpenReadStream(MaxBytes);
            var saved = await Arch.SubirAsync(req, stream, await Actor());
            if (saved is null) { _wizError = "Sin tenant activo."; return; }
            await Exp.AsignarDocumentoAsync(saved.Id, expId, await Actor());
            _wizCargadas.Add(tip.Id);
        }
        catch (Exception ex) { _wizError = ex.Message; }
        finally { _wizSubiendo = null; }
    }

    private async Task WizFinalizar()
    {
        _wizOpen = false;
        _ok = $"Expediente {_wizExpCodigo} listo con {_wizCargadas.Count} documento(s).";
        await CargarExpedientes();
    }

    private RenderFragment RenderTipologia(TipologiaExpDto tip) =>@<div class="wiz-tip">
        <div class="wiz-tip-info">
            <div class="wiz-tip-name"><span class="mono">@tip.Codigo</span> @tip.Nombre</div>
            @if (tip.Formatos.Count > 0)
            {
                <div class="wiz-fmts">@foreach (var f in tip.Formatos) { <span class="wiz-fmt">@f</span> }</div>
            }
        </div>
        <div class="wiz-tip-action">
            @if (_wizCargadas.Contains(tip.Id)) { <span class="wiz-done">&#10003; Cargado</span> }
            else if (_wizSubiendo == tip.Id) { <span class="text-muted">Subiendo...</span> }
            else { <InputFile OnChange="@(e => OnWizArchivo(e, tip))" /> }
        </div>
    </div>;

    private async Task AbrirExpediente(ExpedienteDto e)
    {
        _expSel = e;
        _expSubTab = "docs";
        _verId = null; _verMime = _verNombre = null;
        _versExpandido.Clear();
        _expEstructura = e.SerieId is Guid sid ? await Exp.EstructuraSerieAsync(sid) : null;
        _expSedeDefault = (await Exp.SedesAsync()).FirstOrDefault()?.Nombre ?? "PRINCIPAL";
        await RecargarDocs();
    }

    private async Task RecargarDocs()
    {
        if (_expSel is null) { return; }
        _expDocsGrp = (await Exp.DocsAgrupadosAsync(_expSel.Id)).ToList();
        _expComp = await Exp.CompletitudAsync(_expSel.Id);
    }

    private void ToggleVers(Guid g) { if (!_versExpandido.Add(g)) { _versExpandido.Remove(g); } }
    private void VerDoc(DocExpDto d) { _verId = d.VigenteId; _verMime = d.Mime; _verNombre = d.Nombre; _expSubTab = "visor"; }
    private void VerVersion(DocVersionDto v) { _verId = v.Id; _verMime = v.Mime; _verNombre = v.Nombre; _expSubTab = "visor"; }

    private bool TipEnEstructura(Guid tipId)
    {
        if (_expEstructura is null) { return false; }
        return _expEstructura.TipologiasDirectas.Any(t => t.Id == tipId)
            || _expEstructura.Subseries.Any(s => s.Tipologias.Any(t => t.Id == tipId));
    }

    /// <summary>Documentos que no caen bajo ninguna tipologia de la estructura de la serie.</summary>
    private List<DocExpDto> OtrosDocs() =>
        _expDocsGrp.Where(d => d.TipologiaId is null || !TipEnEstructura(d.TipologiaId!.Value)).ToList();

    private async Task OnAgregarDoc(InputFileChangeEventArgs e, Guid tipId)
    {
        if (_expSel is null) { return; }
        _subiendoTip = tipId; _error = _ok = null;
        try
        {
            var file = e.File;
            var req = new SubirArchivoRequest
            {
                Sucursal = _expSedeDefault,
                Nombre = file.Name,
                TipologiaId = tipId,
                Mime = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType
            };
            await using var stream = file.OpenReadStream(MaxBytes);
            var saved = await Arch.SubirAsync(req, stream, await Actor());
            if (saved is not null) { await Exp.AsignarDocumentoAsync(saved.Id, _expSel.Id, await Actor()); }
            await RecargarDocs();
            await CargarExpedientes();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _subiendoTip = null; }
    }

    private async Task OnReemplazar(InputFileChangeEventArgs e, Guid grupoId)
    {
        if (_expSel is null) { return; }
        _subiendoGrupo = grupoId; _error = _ok = null;
        try
        {
            var file = e.File;
            var req = new SubirArchivoRequest
            {
                Sucursal = _expSedeDefault,
                Nombre = file.Name,
                Mime = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType
            };
            await using var stream = file.OpenReadStream(MaxBytes);
            await Arch.SubirVersionAsync(grupoId, req, stream, await Actor());
            await RecargarDocs();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _subiendoGrupo = null; }
    }

    private static string FamiliaVisor(string? mime, string? nombre)
    {
        var ext = System.IO.Path.GetExtension(nombre ?? "").ToLowerInvariant();
        var m = (mime ?? "").ToLowerInvariant();
        if (m == "application/pdf" || ext == ".pdf") { return "pdf"; }
        if (m.StartsWith("image/") || ext is ".png" or ".jpg" or ".jpeg" or ".gif" or ".webp" or ".bmp") { return "imagen"; }
        if (m.Contains("spreadsheet") || m.Contains("ms-excel") || ext is ".xlsx" or ".xls") { return "html"; }
        if (m.Contains("wordprocessing") || m.Contains("msword") || ext is ".docx" or ".doc") { return "html"; }
        if (m.StartsWith("text/") || ext is ".txt" or ".csv" or ".md" or ".log") { return "html"; }
        return "otro";
    }

    private RenderFragment RenderTipoDocs(TipologiaExpDto tip) =>@<div class="doc-tip">
        @{ var ds = _expDocsGrp.Where(d => d.TipologiaId == tip.Id).ToList(); }
        <div class="doc-tip-h">
            <span class="mono">@tip.Codigo</span> @tip.Nombre
            @if (ds.Count > 0) { <span class="doc-count">@ds.Count doc(s)</span> }
        </div>
        @foreach (var d in ds) { @RenderDocFila(d) }
        @if (_expSel is not null && _expSel.Estado == "ABIERTO")
        {
            <div class="doc-add">
                @if (_subiendoTip == tip.Id) { <span class="text-muted">Subiendo...</span> }
                else { <label class="doc-add-lbl">+ Agregar documento<InputFile style="display:none" OnChange="@(e => OnAgregarDoc(e, tip.Id))" /></label> }
            </div>
        }
    </div>;

    private RenderFragment RenderDocFila(DocExpDto d) =>@<div class="doc-fila">
        <div class="doc-fila-main">
            <span class="doc-name">@d.Nombre</span>
            <span class="doc-ver">v@(d.VersionVigente)</span>
            <span class="ad-badge ad-@d.EstadoAprobacion">@d.EstadoAprobacion</span>
        </div>
        <div class="doc-fila-act">
            <button class="btn btn-outline-primary btn-xs" @onclick="() => VerDoc(d)">Ver</button>
            @if (_expSel is not null && _expSel.Estado == "ABIERTO")
            {
                @if (_subiendoGrupo == d.VersionGrupoId) { <span class="text-muted">Subiendo...</span> }
                else { <label class="btn btn-outline-secondary btn-xs" style="margin:0;">Reemplazar<InputFile style="display:none" OnChange="@(e => OnReemplazar(e, d.VersionGrupoId))" /></label> }
            }
            @if (d.TotalVersiones > 1)
            {
                <button class="btn btn-outline-secondary btn-xs" @onclick="() => ToggleVers(d.VersionGrupoId)">Versiones (@d.TotalVersiones)</button>
            }
        </div>
        @if (_versExpandido.Contains(d.VersionGrupoId))
        {
            <div class="doc-vers">
                @foreach (var v in d.Versiones)
                {
                    <div class="doc-ver-row">
                        <span style="font-weight:600;">v@(v.Version) @(v.Vigente ? "(vigente)" : "")</span>
                        <span class="text-muted">@v.FechaSubida.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                        <button class="btn btn-outline-primary btn-xs" @onclick="() => VerVersion(v)">Ver</button>
                        <a class="btn btn-outline-secondary btn-xs" href="@($"/archivo-digital/{v.Id}/contenido")" target="_blank">Descargar</a>
                    </div>
                }
            </div>
        }
    </div>;

    private RenderFragment RenderVisor() =>@<div>
        @if (_verId is null)
        {
            <div class="trx-empty">Elige un documento para verlo.</div>
        }
        else if (FamiliaVisor(_verMime, _verNombre) == "pdf")
        {
            <iframe src="@($"/archivo-digital/{_verId}/contenido")" class="visor-frame"></iframe>
        }
        else if (FamiliaVisor(_verMime, _verNombre) == "imagen")
        {
            <img src="@($"/archivo-digital/{_verId}/contenido")" class="visor-img" alt="@_verNombre" />
        }
        else if (FamiliaVisor(_verMime, _verNombre) == "html")
        {
            <iframe src="@($"/archivo-digital/{_verId}/preview")" class="visor-frame"></iframe>
        }
        else
        {
            <div class="trx-empty">No hay vista previa. <a href="@($"/archivo-digital/{_verId}/contenido")" target="_blank">Descargar @_verNombre</a>.</div>
        }
    </div>;

    private async Task CerrarExpediente()
    {
        if (_expSel is null) { return; }
        await Exp.CerrarAsync(_expSel.Id, await Actor());
        _ok = $"Expediente {_expSel.Codigo} cerrado.";
        _expSel = null;
        await CargarExpedientes();
    }

    private async Task AsignarAExpediente(Guid archivoId, string expedienteId)
    {
        _error = _ok = null;
        try
        {
            Guid? destino = Guid.TryParse(expedienteId, out var g) ? g : null;
            await Exp.AsignarDocumentoAsync(archivoId, destino, await Actor());
            _ok = destino is null ? "Documento sacado del expediente." : "Documento asignado al expediente.";
            await CargarExpedientes();
            await Load();
        }
        catch (InvalidOperationException ex) { _error = ex.Message; }
    }

    /// <summary>Icono por familia de visor.</summary>
    private static MarkupString IconoMime(string visor) => new(visor switch
    {
        "pdf" => "&#128196;",
        "imagen" => "&#128247;",
        "hoja" => "&#128202;",
        "texto" => "&#128209;",
        _ => "&#128206;"
    });
}
