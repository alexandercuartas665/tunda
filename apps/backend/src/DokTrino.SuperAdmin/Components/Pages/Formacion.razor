@page "/formacion"
@attribute [AllowAnonymous]
@layout DokTrino.SuperAdmin.Components.Layout.PublicLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using DokTrino.Application.Tenancy
@inject ICuestionarioService Cuestionarios
@inject ITrdClienteService Cliente
@inject IClienteCursoService Curso

<PageTitle>Formacion Archimente</PageTitle>

@if (_sesion is null)
{
    <div class="ase-alert">Enlace invalido o token no reconocido. Solicita un nuevo enlace al administrador documental.</div>
}
else
{
    <div class="lms">

        @* ---------- Barra lateral: temario del curso ---------- *@
        <aside class="lms-side">
            <div class="lms-side-head">
                <img class="lms-mascota" src="/img/marca/mascota-saludo.png" alt="Archimente" />
                <div>
                    <div class="lms-curso-t">@(_curso?.Titulo ?? "Formacion Archimente")</div>
                    <div class="lms-curso-s">Aprueba la formacion para diligenciar tu TRD</div>
                </div>
            </div>

            <div class="lms-prog">
                <div class="lms-prog-bar"><span style="width:@(Progreso)%"></span></div>
                <div class="lms-prog-txt">@Progreso% completado &middot; @_vistas.Count/@TotalLecciones lecciones</div>
            </div>

            <div class="lms-temario">
                @foreach (var g in _seq.Where(n => !n.EsEval).GroupBy(n => n.ModuloTitulo))
                {
                    <div class="lms-sec">
                        <div class="lms-sec-t">@g.Key</div>
                        @foreach (var n in g)
                        {
                            var i = _seq.IndexOf(n);
                            <button class="lms-item @(i == _sel ? "on" : "") @(_vistas.Contains(n.Leccion!.Id) ? "done" : "")"
                                    @onclick="() => Ir(i)">
                                <span class="lms-item-ck">@(_vistas.Contains(n.Leccion!.Id) ? "\u2713" : IconoTipo(n.Leccion!.Tipo))</span>
                                <span class="lms-item-t">@n.Leccion!.Titulo</span>
                            </button>
                        }
                    </div>
                }

                @if (_evalIndex is int ei)
                {
                    <div class="lms-sec">
                        <div class="lms-sec-t">Evaluacion</div>
                        <button class="lms-item lms-item-eval @(ei == _sel ? "on" : "") @(Aprobado ? "done" : "")"
                                @onclick="() => Ir(ei)">
                            <span class="lms-item-ck">@(Aprobado ? "\u2713" : (_gate.Bloqueado ? "\U0001F512" : "\U0001F4DD"))</span>
                            <span class="lms-item-t">Evaluacion final</span>
                        </button>
                    </div>
                }
            </div>
        </aside>

        @* ---------- Area principal: leccion o evaluacion ---------- *@
        <main class="lms-main">
            @if (_error is not null) { <div class="ase-alert">@_error</div> }

            @if (_seq.Count == 0)
            {
                <div class="lms-vacio">Tu entidad todavia no publico contenido de formacion. Puedes diligenciar tu TRD.</div>
                <a class="lms-btn" href="@($"trd-cliente?token={Token}")">Ir a mi encuesta &rarr;</a>
            }
            else
            {
                var nodo = _seq[_sel];

                @if (!nodo.EsEval && nodo.Leccion is LeccionClienteDto l)
                {
                    @* ----- Leccion ----- *@
                    <div class="lms-crumb">@nodo.ModuloTitulo</div>
                    <h1 class="lms-lec-t">@l.Titulo</h1>

                    <div class="lms-media-wrap">
                        @{ var src = $"/capacitaciones/cliente/leccion/{l.Id}/recurso?token={Token}"; }
                        @if (l.Tipo == "VIDEO" && l.TieneArchivo)
                        {
                            @* preload/playsinline ayudan al render; si el video se ve negro (audio ok) en
                               Opera/Chrome suele ser el codec: subir el mp4 en H.264 (no HEVC/H.265). *@
                            <video class="lms-video" controls playsinline preload="metadata" src="@src"></video>
                        }
                        else if (l.Tipo == "IMAGEN" && l.TieneArchivo)
                        {
                            <img class="lms-img" src="@src" alt="@l.Titulo" />
                        }
                        else if (l.Tipo == "PDF" && l.TieneArchivo)
                        {
                            <iframe class="lms-pdf" src="@src" title="@l.Titulo"></iframe>
                        }
                        else if (l.Tipo == "TEXTO" && !string.IsNullOrWhiteSpace(l.Contenido))
                        {
                            <div class="lms-texto">@l.Contenido</div>
                        }
                        else
                        {
                            <div class="lms-vacio">Esta leccion todavia no tiene su recurso cargado.</div>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(l.Descripcion))
                    {
                        <p class="lms-lec-d">@l.Descripcion</p>
                    }

                    <div class="lms-nav">
                        <button class="lms-btn ghost" disabled="@(_sel == 0)" @onclick="Anterior">&larr; Anterior</button>
                        <button class="lms-btn" @onclick="() => CompletarYContinuar(l.Id)">
                            @(_sel == _seq.Count - 1 ? "Marcar visto" : "Marcar visto y continuar \u2192")
                        </button>
                    </div>
                }
                else
                {
                    @* ----- Evaluacion final ----- *@
                    <div class="lms-crumb">Evaluacion final</div>

                    @if (!_estado.HayCuestionario)
                    {
                        <div class="lms-ok">&#10003; No hay evaluacion configurada. Ya puedes diligenciar tu TRD.</div>
                        <a class="lms-btn" href="@($"trd-cliente?token={Token}")">Ir a mi encuesta &rarr;</a>
                    }
                    else if (Aprobado)
                    {
                        <div class="lms-aprob">
                            <div class="lms-aprob-ico">&#127881;</div>
                            <div class="lms-aprob-t">Felicitaciones, superaste la formacion</div>
                            <div class="lms-aprob-s">Ya puedes diligenciar la Tabla de Retencion Documental de tu dependencia.</div>
                            <a class="lms-btn" href="@($"trd-cliente?token={Token}")">Ir a mi encuesta &rarr;</a>
                        </div>
                    }
                    else if (_gate.Bloqueado)
                    {
                        <div class="lms-block">
                            <div class="lms-block-ico">&#128274;</div>
                            <div class="lms-block-t">Evaluacion bloqueada</div>
                            <div class="lms-block-s">
                                Agotaste los @_gate.IntentosMax intento(s) sin aprobar. Pide al administrador
                                documental que te desbloquee para volver a intentarlo.
                            </div>
                        </div>
                    }
                    else if (_cuestionario is not null)
                    {
                        <h1 class="lms-lec-t">@_cuestionario.Titulo</h1>
                        <p class="lms-lec-d">
                            Necesitas al menos @(_cuestionario.PuntajeMinimo) puntos para aprobar.
                            Tienes @_gate.IntentosMax intento(s) en total.
                            @if (_estado.Intentos > 0)
                            {
                                <text> Llevas @_estado.Intentos; tu mejor puntaje es @_estado.MejorPuntaje.</text>
                            }
                        </p>

                        @if (_resultado is not null)
                        {
                            <div class="lms-result @(_resultado.Aprobado ? "ok" : "no")">
                                <div class="lms-result-score">@_resultado.Puntaje<span>/100</span></div>
                                <div class="lms-result-txt">
                                    @_resultado.Correctas de @_resultado.Total correctas &mdash;
                                    @(_resultado.Aprobado ? "aprobado" : "no alcanza el minimo")
                                </div>
                                @if (_resultado.Retroalimentacion.Count > 0)
                                {
                                    <ul class="lms-result-fb">
                                        @foreach (var r in _resultado.Retroalimentacion) { <li>@r</li> }
                                    </ul>
                                }
                            </div>
                        }

                        <div class="lms-quiz">
                            @foreach (var (p, idx) in _cuestionario.Preguntas.Select((p, i) => (p, i)))
                            {
                                <div class="lms-preg">
                                    <div class="lms-preg-t">@(idx + 1). @p.Enunciado</div>
                                    @foreach (var (op, oi) in p.Opciones.Select((o, i) => (o, i)))
                                    {
                                        <label class="lms-op @(_respuestas.Length > idx && _respuestas[idx] == oi ? "sel" : "")">
                                            <input type="radio" name="@($"p{idx}")" checked="@(_respuestas[idx] == oi)"
                                                   @onchange="() => _respuestas[idx] = oi" />
                                            <span>@op</span>
                                        </label>
                                    }
                                </div>
                            }
                        </div>

                        <div class="lms-nav">
                            <button class="lms-btn ghost" @onclick="Anterior">&larr; Volver al contenido</button>
                            <button class="lms-btn" @onclick="Enviar">
                                @(_estado.Intentos > 0 ? "Volver a intentarlo" : "Enviar evaluacion")
                            </button>
                        </div>
                    }
                }
            }
        </main>
    </div>
}

<style>
    .lms { display:flex; gap:0; align-items:stretch; min-height:calc(100vh - 130px);
           background:#fff; border:1px solid #e6e9f2; border-radius:16px; overflow:hidden; }

    /* Sidebar */
    .lms-side { width:320px; flex-shrink:0; background:#0f1830; color:#dfe6f5; display:flex; flex-direction:column; }
    @@media (max-width: 820px) { .lms { flex-direction:column; } .lms-side { width:auto; } }
    .lms-side-head { display:flex; gap:12px; align-items:center; padding:18px 18px 14px; border-bottom:1px solid #1e2a49; }
    .lms-mascota { height:52px; width:auto; flex-shrink:0; }
    .lms-curso-t { font-size:14px; font-weight:800; color:#fff; line-height:1.25; }
    .lms-curso-s { font-size:11px; color:#8ea1c9; margin-top:3px; }
    .lms-prog { padding:14px 18px; border-bottom:1px solid #1e2a49; }
    .lms-prog-bar { height:7px; border-radius:7px; background:#1e2a49; overflow:hidden; }
    .lms-prog-bar span { display:block; height:100%; background:linear-gradient(90deg,#2f80ff,#57c785); transition:width .3s; }
    .lms-prog-txt { font-size:11px; color:#8ea1c9; margin-top:7px; font-weight:600; }
    .lms-temario { flex:1; overflow-y:auto; padding:8px 0 16px; }
    .lms-sec { padding:8px 0; }
    .lms-sec-t { font-size:10.5px; font-weight:800; text-transform:uppercase; letter-spacing:.5px; color:#6f83ac; padding:6px 18px; }
    .lms-item { width:100%; display:flex; align-items:center; gap:10px; padding:9px 18px; background:transparent;
                border:0; border-left:3px solid transparent; color:#c7d2e8; font-size:12.5px; text-align:left; cursor:pointer; }
    .lms-item:hover { background:#16223f; }
    .lms-item.on { background:#16223f; border-left-color:#2f80ff; color:#fff; font-weight:700; }
    .lms-item.done .lms-item-ck { color:#57c785; }
    .lms-item-ck { width:18px; flex-shrink:0; text-align:center; font-size:12px; }
    .lms-item-t { flex:1; line-height:1.3; }
    .lms-item-eval { font-weight:700; }

    /* Main */
    .lms-main { flex:1; min-width:0; padding:26px 30px; overflow-y:auto; }
    .lms-crumb { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.4px; color:#8a93a8; margin-bottom:6px; }
    .lms-lec-t { font-size:22px; font-weight:800; color:#1f2433; letter-spacing:-.3px; margin:0 0 16px; }
    .lms-lec-d { font-size:13.5px; color:#4a5878; line-height:1.7; margin:14px 0 0; }
    .lms-media-wrap { background:#0b1020; border-radius:14px; overflow:hidden; display:flex; justify-content:center; align-items:center; }
    .lms-video { width:100%; max-height:62vh; display:block; }
    .lms-img { width:100%; max-height:62vh; object-fit:contain; display:block; background:#0b1020; }
    .lms-pdf { width:100%; height:70vh; border:0; background:#fff; }
    .lms-texto { white-space:pre-wrap; font-size:14px; line-height:1.75; color:#e7ecf6; padding:26px 30px; width:100%; }
    .lms-vacio { padding:40px; text-align:center; font-size:13px; color:#8a93a8; }

    .lms-nav { display:flex; justify-content:space-between; gap:10px; margin-top:22px; }
    .lms-btn { border:0; cursor:pointer; background:var(--primary); color:#fff; border-radius:10px;
               padding:11px 18px; font-size:13px; font-weight:700; text-decoration:none; display:inline-flex; align-items:center; }
    .lms-btn:hover { filter:brightness(1.05); }
    .lms-btn.ghost { background:#eef1f7; color:#4a5878; }
    .lms-btn:disabled { opacity:.45; cursor:default; }

    /* Evaluacion */
    .lms-quiz { margin-top:8px; }
    .lms-preg { padding:16px 0; border-bottom:1px solid #f1f3f8; }
    .lms-preg-t { font-size:14px; font-weight:700; color:#1f2433; margin-bottom:11px; }
    .lms-op { display:flex; align-items:center; gap:10px; padding:9px 12px; margin-bottom:7px; font-size:13px; color:#37415c;
              cursor:pointer; border:1px solid #e6e9f2; border-radius:10px; }
    .lms-op:hover { border-color:var(--primary); }
    .lms-op.sel { border-color:var(--primary); background:var(--primary-soft); font-weight:600; }
    .lms-result { border-radius:12px; padding:16px 18px; margin-bottom:18px; }
    .lms-result.ok { background:#eefaf1; border:1px solid #bfe6cb; }
    .lms-result.no { background:#fdf6ec; border:1px solid #f0e2c4; }
    .lms-result-score { font-size:34px; font-weight:800; letter-spacing:-1px; color:#1f2433; }
    .lms-result-score span { font-size:15px; font-weight:600; color:#9aa3bd; }
    .lms-result-txt { font-size:12.5px; color:#4a5878; margin-top:2px; }
    .lms-result-fb { margin:10px 0 0; padding-left:18px; font-size:12px; color:#6b7488; }

    .lms-ok { font-size:14px; font-weight:700; color:#15803d; margin-bottom:14px; }
    .lms-aprob, .lms-block { text-align:center; padding:40px 24px; }
    .lms-aprob-ico, .lms-block-ico { font-size:48px; }
    .lms-aprob-t { font-size:20px; font-weight:800; color:#15803d; margin:10px 0 6px; }
    .lms-block-t { font-size:19px; font-weight:800; color:#b45309; margin:10px 0 6px; }
    .lms-aprob-s, .lms-block-s { font-size:13px; color:#5b6478; line-height:1.6; max-width:460px; margin:0 auto 18px; }
</style>

@code {
    [SupplyParameterFromQuery(Name = "token")] public string? Token { get; set; }

    private sealed record NavNode(string ModuloTitulo, LeccionClienteDto? Leccion, bool EsEval);

    private TokenSesionDto? _sesion;
    private CuestionarioDto? _cuestionario;
    private EstadoCapacitacionDto _estado = new(false, 0, 0, false);
    private CursoGateDto _gate = new(false, false, null, null, null, false, false, 0, 0);
    private CursoClienteDto? _curso;
    private ResultadoIntentoDto? _resultado;
    private int[] _respuestas = [];
    private string? _error;

    // Secuencia navegable: lecciones (por modulo) + evaluacion final al cierre.
    private readonly List<NavNode> _seq = new();
    private int _sel;
    private int? _evalIndex;
    // Lecciones marcadas como vistas (progreso visual; la compuerta real es aprobar la evaluacion).
    private readonly HashSet<Guid> _vistas = new();

    private int TotalLecciones => _seq.Count(n => n.Leccion is not null);
    private int Progreso
    {
        get
        {
            if (Aprobado) { return 100; }
            var tot = TotalLecciones + (_evalIndex is null ? 0 : 1);
            if (tot == 0) { return 0; }
            return Math.Clamp((int)Math.Round(_vistas.Count * 100.0 / tot), 0, 99);
        }
    }

    /// <summary>Aprobado real: si hay curso vigente lo dice el gate; si no, el quiz suelto.</summary>
    private bool Aprobado => _gate.HayCurso ? _gate.Aprobado : _estado.Superado;

    protected override async Task OnInitializedAsync()
    {
        var t = Token ?? "";
        _sesion = await Cliente.ResolverTokenAsync(t);
        if (_sesion is null) { return; }

        await Curso.RegistrarInicioAsync(t);
        _curso = await Curso.CursoAsync(t);
        await Recargar();
        ConstruirSecuencia();
    }

    private void ConstruirSecuencia()
    {
        _seq.Clear();
        if (_curso is not null)
        {
            foreach (var m in _curso.Modulos)
            {
                foreach (var l in m.Lecciones)
                {
                    _seq.Add(new NavNode(m.Titulo, l, false));
                }
            }
        }
        if (_estado.HayCuestionario)
        {
            _seq.Add(new NavNode("Evaluacion", null, true));
            _evalIndex = _seq.Count - 1;
        }
        else
        {
            _evalIndex = null;
        }
        _sel = Math.Clamp(_sel, 0, Math.Max(0, _seq.Count - 1));
    }

    private async Task Recargar()
    {
        var t = Token ?? "";
        _cuestionario = await Cuestionarios.ObtenerPorTokenAsync(t);
        _estado = await Cuestionarios.EstadoAsync(t);
        _gate = await Curso.GateAsync(t);

        var n = _cuestionario?.Preguntas.Count ?? 0;
        if (_respuestas.Length != n) { _respuestas = Enumerable.Repeat(-1, n).ToArray(); }
    }

    private void Ir(int i) { if (i >= 0 && i < _seq.Count) { _sel = i; _error = null; } }
    private void Anterior() { if (_sel > 0) { _sel--; } }

    private void CompletarYContinuar(Guid leccionId)
    {
        _vistas.Add(leccionId);
        if (_sel < _seq.Count - 1) { _sel++; }
    }

    private async Task Enviar()
    {
        _error = null;
        if (_respuestas.Any(r => r < 0))
        {
            _error = "Responde todas las preguntas antes de enviar.";
            return;
        }
        try
        {
            _resultado = await Cuestionarios.ResponderAsync(Token ?? "", _respuestas);
            _respuestas = Enumerable.Repeat(-1, _cuestionario?.Preguntas.Count ?? 0).ToArray();
            await Recargar();
        }
        catch (InvalidOperationException ex) { _error = ex.Message; }
    }

    private static string IconoTipo(string tipo) => tipo switch
    {
        "VIDEO" => "\u25B6",
        "IMAGEN" => "\U0001F5BC",
        "PDF" => "\U0001F4C4",
        "TEXTO" => "\U0001F4C3",
        _ => "\u2022"
    };
}
