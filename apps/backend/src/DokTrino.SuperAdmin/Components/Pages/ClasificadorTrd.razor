@page "/clasificador-trd"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using DokTrino.Application.Tenancy
@using System.Security.Claims
@inject IAiUsageService Consumo
@inject IAiAgentService Agentes
@inject IAgenteCerebrosService AgenteCerebros
@inject IAiInferenceService Inferencia
@inject ICerebroService Cerebros
@inject IJSRuntime JS

<PageTitle>Agentes TRD - Archimente</PageTitle>

@* --- Hero con la mascota: le da cara a los agentes de IA del modulo --- *@
<div class="clia-hero">
    <img class="clia-mascota" src="/img/marca/mascota-superheroe.png" alt="" aria-hidden="true" />
    <div class="clia-hero-txt">
        <div class="clia-eyebrow">IA Documental &middot; Archimente</div>
        <h1 class="clia-title">Agentes de la TRD</h1>
        <p class="clia-sub">
            Cada agente tiene una mision y un conjunto de prompts (los pasos en que se divide su trabajo).
            El de <b>generacion</b> arma el procedimiento por segmentos; podras ejecutar cada paso por separado
            desde el documento en <b>Transacciones documentales</b>.
        </p>
    </div>
</div>

@* --- Consumo de IA del tenant --- *@
<div class="clia-kpis">
    <div class="clia-kpi">
        <div class="k">Tokens consumidos</div>
        <div class="v">@Tokens(_consumo.TotalTokens)</div>
        <div class="h">@Tokens(_consumo.InputTokens) entrada &middot; @Tokens(_consumo.OutputTokens) salida</div>
    </div>
    <div class="clia-kpi">
        <div class="k">Llamadas de IA</div>
        <div class="v">@_consumo.TotalCalls</div>
    </div>
    <div class="clia-kpi">
        <div class="k">Costo estimado</div>
        <div class="v">$@_consumo.EstimatedCostUsd.ToString("0.####")</div>
        <div class="h">USD, aproximado por tarifa del proveedor</div>
    </div>
    @if (_cupo.HasLimit)
    {
        <div class="clia-kpi">
            <div class="k">Cupo mensual</div>
            <div class="v">@_cupo.UsedPct%</div>
            <div class="clia-bar"><span style="width:@(_cupo.UsedPct)%"></span></div>
            <div class="h">@Tokens(_cupo.MonthlyUsedTokens) / @Tokens(_cupo.MonthlyLimitTokens) tokens</div>
        </div>
    }
</div>

@if (_error is not null) { <div class="ase-alert">@_error</div> }
@if (_ok is not null) { <div class="ase-ok">@_ok</div> }

@if (_cargando)
{
    <div class="ase-card"><div class="dep-ind-load">Cargando agentes...</div></div>
}
else if (_agentes.Count == 0)
{
    <div class="ase-card">
        <div class="ase-card-h">Sin agentes todavia</div>
        <p class="text-muted" style="margin:0;">
            El agente de <b>generacion de procedimientos</b> se crea solo la primera vez que generas
            un procedimiento desde una fila de la TRD (Transacciones documentales). Vuelve aqui y lo veras
            como tarjeta con sus pasos.
        </p>
    </div>
}
else
{
    <div class="ag-grid">
        @foreach (var a in _agentes)
        {
            <div class="ag-card @(EsGeneracion(a.Agent) ? "gen" : "")">
                <div class="ag-card-h">
                    <img class="ag-ic" src="/img/marca/mascota-superheroe.png" alt="" aria-hidden="true" />
                    <div class="ag-id">
                        <div class="ag-nom">@a.Agent.Name</div>
                        <div class="ag-rol">@RolLabel(a.Agent.Role)</div>
                    </div>
                    <span class="ag-estado @(a.Agent.IsActive ? "on" : "off")">@(a.Agent.IsActive ? "Activo" : "Inactivo")</span>
                </div>

                @* --- Motor de IA del agente --- *@
                <div class="agm">
                    <span class="agm-t">Motor de IA</span>
                    @if (_motores.Count == 0)
                    {
                        <span class="agc-vacio">La plataforma no tiene motores de IA habilitados.</span>
                    }
                    else
                    {
                        var efectivo = _motores.FirstOrDefault(m => m.Provider == a.Agent.Provider) ?? _motores[0];
                        <div class="agm-ops">
                            @foreach (var m in _motores)
                            {
                                var on = m.Provider == efectivo.Provider;
                                <button type="button" class="agm-op @(on ? "on" : "") agm-@m.Provider.ToString().ToLowerInvariant()"
                                        disabled="@(!_esAdmin || _guardando)"
                                        title="@(!_esAdmin ? "Solo el administrador de la entidad lo cambia" : on ? "Motor actual" : "Usar " + m.Nombre)"
                                        @onclick="() => FijarMotor(a.Agent, m.Provider)">
                                    <span class="agm-dot"></span>
                                    <span class="agm-n">@m.Nombre</span>
                                    <span class="agm-m">@m.Modelo</span>
                                </button>
                            }
                        </div>
                        @if (_motores.All(m => m.Provider != a.Agent.Provider))
                        {
                            <div class="agc-ayuda">El motor guardado (@a.Agent.Provider) no esta habilitado: usa @efectivo.Nombre.</div>
                        }
                    }
                </div>

                <div class="ag-sec-t">Mision</div>
                @if (_editMisionId == a.Agent.Id)
                {
                    <textarea class="form-control ag-ta" rows="6" @bind="_misionTexto"></textarea>
                    <div class="ag-btns">
                        <button class="btn btn-primary btn-sm" @onclick="() => GuardarMision(a.Agent)" disabled="@_guardando">Guardar mision</button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => _editMisionId = null" disabled="@_guardando">Cancelar</button>
                    </div>
                }
                else
                {
                    <div class="ag-mision">@Resumen(a.Agent.SystemPrompt)</div>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => EditarMision(a.Agent)">Editar mision</button>
                }

                @if (a.Prompts.Count > 0)
                {
                    <div class="ag-sec-t">Pasos / prompts (@a.Prompts.Count)</div>
                    <div class="ag-pasos">
                        @foreach (var p in a.Prompts.OrderBy(x => x.SortOrder))
                        {
                            <div class="ag-paso">
                                <div class="ag-paso-h" @onclick="() => TogglePrompt(p.Id)">
                                    <span class="ag-paso-n">@p.SortOrder</span>
                                    <span class="ag-paso-nom">@p.Name</span>
                                    <span class="ag-caret">@((MarkupString)(_promptAbierto == p.Id ? "&#9662;" : "&#9656;"))</span>
                                </div>
                                @if (_promptAbierto == p.Id)
                                {
                                    <textarea class="form-control ag-ta" rows="7" @bind="_promptTexto"></textarea>
                                    <div class="ag-btns">
                                        <button class="btn btn-primary btn-sm" @onclick="() => GuardarPrompt(a.Agent, p)" disabled="@_guardando">Guardar paso</button>
                                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => _promptAbierto = null" disabled="@_guardando">Cerrar</button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    @if (EsGeneracion(a.Agent))
                    {
                        <div class="ag-nota">
                            Para <b>ejecutar cada paso por separado</b>, abre el procedimiento de una fila en
                            Transacciones documentales: alli estan los botones <i>Que es &middot; Elimina &middot; Conserva &middot; Unificar</i>.
                        </div>
                    }
                }

                @* --- Cerebros que el agente puede consultar --- *@
                <div class="ag-sec-t">Cerebros que consulta</div>
                @{ var cbs = _cerebrosPorAgente.GetValueOrDefault(a.Agent.Id) ?? new List<CerebroDeAgenteDto>(); }
                @if (cbs.Count == 0)
                {
                    <div class="agc-vacio">La entidad aun no tiene cerebros. Crealos en <a href="/cerebros">Cerebros</a>.</div>
                }
                else
                {
                    <div class="agc-cbs">
                        @foreach (var c in cbs)
                        {
                            var bloqueado = c.Bloqueado || !_esAdmin;
                            <button type="button" class="agc-cb @(c.Seleccionado ? "on" : "")" disabled="@bloqueado"
                                    title="@(c.Bloqueado ? "Lo decide la plataforma" : !_esAdmin ? "Solo el administrador de la entidad lo cambia" : c.Seleccionado ? "Quitar este cerebro" : "Dejar que el agente lo consulte")"
                                    @onclick="() => AlternarCerebro(a.Agent.Id, c)">
                                <span class="agc-check">@((MarkupString)(c.Seleccionado ? "&#10003;" : ""))</span>
                                <span class="agc-cb-n">@c.Nombre</span>
                                <span class="agc-cb-c">@c.Notas</span>
                                @if (c.Bloqueado) { <span>&#128274;</span> }
                            </button>
                        }
                    </div>
                    <div class="agc-ayuda">
                        @(cbs.Count(x => x.Seleccionado)) de @cbs.Count seleccionado(s).
                        @if (EsGeneracion(a.Agent)) { <span>Es la misma marca <i>Referencia de la IA documental</i> de cada cerebro: la usa al generar procedimientos.</span> }
                        else { <span>El agente los consulta al responder en el chat.</span> }
                    </div>
                }

                @* --- Chat con el agente --- *@
                <div class="agc-chat-h">
                    <div class="ag-sec-t">Hablar con el agente</div>
                    @{ var modo = _modos.GetValueOrDefault(a.Agent.Id, "profundo"); }
                    <div class="agc-modo" title="Que tan a fondo investiga sus cerebros antes de responder">
                        <button type="button" class="@(modo == "rapido" ? "on" : "")" disabled="@(!_esAdmin || _guardando)"
                                title="@(_esAdmin ? "Una o dos busquedas y respuesta breve (menos tokens)" : "Solo el administrador de la entidad lo cambia")"
                                @onclick="() => FijarModo(a.Agent, AgenteCerebrosService.ModoRapido)">&#9889; Rapido</button>
                        <button type="button" class="@(modo == "profundo" ? "on" : "")" disabled="@(!_esAdmin || _guardando)"
                                title="@(_esAdmin ? "Investiga a fondo: varias busquedas, abre y cruza notas (mas tokens)" : "Solo el administrador de la entidad lo cambia")"
                                @onclick="() => FijarModo(a.Agent, AgenteCerebrosService.ModoProfundo)">&#128269; Profundo</button>
                    </div>
                </div>
                @{ var chat = Chat(a.Agent.Id); }
                <div class="agc-chat">
                    <div class="agc-msgs" id="agc-msgs-@a.Agent.Id.ToString("N")">
                        @if (chat.Mensajes.Count == 0)
                        {
                            <div class="agc-vacio">Preguntale algo. @(cbs.Any(x => x.Seleccionado) ? "Buscara la respuesta en sus cerebros." : "Sin cerebros asignados responde solo con conocimiento general.")</div>
                        }
                        @foreach (var m in chat.Mensajes)
                        {
                            <div class="agc-msg @(m.Role == "user" ? "yo" : "bot")">
                                @if (m.Role == "user") { @m.Text }
                                else { <div class="agc-md">@((MarkupString)MarkdownCerebro.Render(m.Text, "", _sinClaves))</div> }
                            </div>
                            @if (m.Role != "user" && m.Fuentes is not null)
                            {
                                var leidas = m.Fuentes.Where(f => f.Leida).ToList();
                                var vistas = m.Fuentes.Where(f => !f.Leida).ToList();
                                <div class="agc-fuentes">
                                    @if (m.Fuentes.Count == 0)
                                    {
                                        <div class="agc-f-alerta">&#9888; Respondio <b>sin consultar</b> sus cerebros: no tomes esta respuesta como respaldada por ellos.</div>
                                    }
                                    else
                                    {
                                        @if (leidas.Count > 0)
                                        {
                                            <div class="agc-f-fila">
                                                <span class="agc-f-t">Notas leidas</span>
                                                @foreach (var f in leidas)
                                                {
                                                    <a class="agc-f leida" href="@MarkdownCerebro.UrlNota(f.CerebroSlug, f.Titulo)" target="_blank" rel="noopener"
                                                       title="@($"{f.CerebroNombre} - abrir la nota{(f.Truncada ? " (el agente leyo solo el inicio: es muy larga)" : "")}")">&#128196; @f.Titulo@(f.Truncada ? " *" : "")</a>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="agc-f-alerta suave">No abrio ninguna nota completa: se baso solo en fragmentos de la busqueda.</div>
                                        }
                                        @if (vistas.Count > 0)
                                        {
                                            <details class="agc-f-mas">
                                                <summary>@vistas.Count nota(s) vistas solo en la busqueda</summary>
                                                <div class="agc-f-fila">
                                                    @foreach (var f in vistas)
                                                    {
                                                        <a class="agc-f" href="@MarkdownCerebro.UrlNota(f.CerebroSlug, f.Titulo)" target="_blank" rel="noopener" title="@f.CerebroNombre">@f.Titulo</a>
                                                    }
                                                </div>
                                            </details>
                                        }
                                    }
                                </div>
                            }
                        }
                        @if (chat.Ocupado)
                        {
                            <div class="agc-msg bot agc-pensando"><span></span><span></span><span></span>
                                <em>@(modo == "profundo" && cbs.Any(x => x.Seleccionado) ? "Investigando en sus cerebros..." : "Pensando...")</em></div>
                        }
                    </div>
                    @if (chat.Error is not null) { <div class="agc-error">@chat.Error</div> }
                    <div class="agc-in">
                        <textarea rows="2" placeholder="Escribe tu pregunta... (Ctrl+Enter envia)" @bind="chat.Texto" @bind:event="oninput"
                                  @onkeydown="e => TeclaChat(e, a.Agent.Id)" disabled="@chat.Ocupado"></textarea>
                        <div class="agc-in-acc">
                            @if (chat.Mensajes.Count > 0) { <button class="btn btn-outline-secondary btn-sm" @onclick="() => chat.Limpiar()" disabled="@chat.Ocupado">Limpiar</button> }
                            <button class="btn btn-primary btn-sm" @onclick="() => EnviarChat(a.Agent.Id)" disabled="@(chat.Ocupado || string.IsNullOrWhiteSpace(chat.Texto))">Enviar</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    /* Hero con mascota */
    .clia-hero { position: relative; overflow: hidden; display: flex; align-items: center; gap: 20px;
                 background: linear-gradient(135deg, var(--primary-deep), var(--primary)); color: #fff;
                 border-radius: 18px; padding: 20px 26px; margin-bottom: 16px; box-shadow: 0 14px 36px var(--primary-shadow); }
    .clia-mascota { height: 118px; width: auto; flex-shrink: 0; filter: drop-shadow(0 8px 16px rgba(0,0,0,.28)); }
    @@media (max-width: 640px) { .clia-mascota { display: none; } }
    .clia-eyebrow { font-size: 10.5px; font-weight: 800; letter-spacing: .5px; text-transform: uppercase; opacity: .85; }
    .clia-title { font-size: 1.7rem; font-weight: 800; letter-spacing: -.02em; margin: 3px 0 6px; }
    .clia-sub { font-size: 13px; line-height: 1.6; color: rgba(255,255,255,.92); margin: 0; max-width: 760px; }

    /* KPIs de consumo */
    .clia-kpis { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 12px; margin-bottom: 16px; }
    @@media (max-width: 900px) { .clia-kpis { grid-template-columns: repeat(2, minmax(0,1fr)); } }
    .clia-kpi { background: #fff; border: 1px solid #e6e9f2; border-radius: 12px; padding: 13px 15px; }
    .clia-kpi .k { font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .3px; color: #8a93ad; }
    .clia-kpi .v { font-size: 1.5rem; font-weight: 800; color: #1f2433; letter-spacing: -.02em; margin: 2px 0; }
    .clia-kpi .h { font-size: 11px; color: #9aa3bd; }
    .clia-bar { height: 6px; border-radius: 6px; background: #eef1f7; overflow: hidden; margin: 4px 0; }
    .clia-bar span { display: block; height: 100%; background: var(--primary); }

    /* Tarjetas de agentes */
    .ag-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 14px; }
    @@media (max-width: 900px) { .ag-grid { grid-template-columns: 1fr; } }
    .ag-card { background:#fff; border:1px solid #e6e9f2; border-radius:14px; padding:16px 18px; }
    .ag-card.gen { border-color:var(--primary); box-shadow:0 8px 22px var(--primary-shadow); }
    .ag-card-h { display:flex; align-items:center; gap:11px; }
    .ag-ic { height:44px; width:auto; }
    .ag-id { flex:1; min-width:0; }
    .ag-nom { font-size:15px; font-weight:800; color:#1f2433; }
    .ag-rol { font-size:12px; color:#6b7593; }
    .ag-estado { font-size:10px; font-weight:800; padding:2px 8px; border-radius:20px; }
    .ag-estado.on { background:#e8f5ee; color:#2f7d54; }
    .ag-estado.off { background:#f1f3f8; color:#9aa3bd; }
    .ag-sec-t { font-size:11px; font-weight:700; color:#1f2433; text-transform:uppercase; letter-spacing:.4px; margin:14px 0 7px; }
    .ag-mision { font-size:12.5px; line-height:1.6; color:#59617a; white-space:pre-wrap; max-height:120px; overflow:auto; margin-bottom:8px; }
    .ag-ta { font-family:'JetBrains Mono','Consolas',monospace; font-size:12px; line-height:1.55; }
    .ag-btns { display:flex; gap:8px; margin-top:8px; flex-wrap:wrap; }
    .ag-pasos { display:flex; flex-direction:column; gap:6px; }
    .ag-paso { border:1px solid #eef1f7; border-radius:9px; overflow:hidden; }
    .ag-paso-h { display:flex; align-items:center; gap:9px; padding:8px 11px; cursor:pointer; user-select:none; }
    .ag-paso-h:hover { background:#f6f8fc; }
    .ag-paso-n { width:20px; height:20px; border-radius:6px; background:var(--primary-soft); color:var(--primary);
                 font-size:11px; font-weight:800; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .ag-paso-nom { flex:1; font-size:12.5px; font-weight:600; color:#2a2f3d; }
    .ag-caret { color:var(--primary); font-size:11px; }
    .ag-paso .ag-ta { margin:0 11px 11px; width:calc(100% - 22px); }
    .ag-paso .ag-btns { padding:0 11px 11px; margin-top:0; }
    .ag-nota { font-size:12px; color:#59617a; background:#f6f8fc; border-radius:9px; padding:9px 11px; margin-top:10px; }
    .ase-card { background:#fff; border:1px solid #e6e9f2; border-radius:14px; padding:16px 18px; margin-bottom:14px; }
    .ase-card-h { font-size:14px; font-weight:800; color:#1f2433; margin-bottom:8px; }
    .ase-alert { background:#fdecea; color:#b02a1a; border-radius:10px; padding:10px 13px; margin-bottom:12px; font-size:13px; }
    .ase-ok { background:#e8f5ee; color:#2f7d54; border-radius:10px; padding:10px 13px; margin-bottom:12px; font-size:13px; }
    .dep-ind-load { color:#9aa3bd; font-style:italic; }

    /* Motor de IA del agente */
    .agm { display:flex; flex-direction:column; gap:6px; margin:2px 0 12px; }
    .agm-t { font-size:11px; font-weight:800; letter-spacing:.06em; text-transform:uppercase; color:#8a93ad; }
    .agm-ops { display:flex; flex-wrap:wrap; gap:6px; }
    .agm-op { --agm:#5b6b8c; display:inline-flex; align-items:center; gap:7px; border:1px solid #dfe4ef; background:#fff;
              border-radius:10px; padding:6px 11px; font-size:12.5px; color:#3a4158; cursor:pointer; transition:all .15s; }
    .agm-op:hover:not(:disabled) { border-color:var(--agm); }
    .agm-op:disabled { cursor:not-allowed; }
    .agm-op:disabled:not(.on) { opacity:.6; }
    .agm-op.on { border-color:var(--agm); box-shadow:0 0 0 2px color-mix(in srgb, var(--agm) 18%, transparent); font-weight:700; }
    .agm-dot { width:9px; height:9px; border-radius:50%; background:#d5dae6; }
    .agm-op.on .agm-dot { background:var(--agm); }
    .agm-m { font-size:10.5px; color:#9aa3bd; font-weight:600; font-family:ui-monospace, monospace; }
    .agm-claude { --agm:#c96442; } .agm-gemini { --agm:#3b74e6; } .agm-chatgpt { --agm:#10a37f; } .agm-deepseek { --agm:#4d6bfe; }

    /* Cerebros del agente */
    .agc-cbs { display:flex; flex-wrap:wrap; gap:6px; }
    .agc-cb { display:inline-flex; align-items:center; gap:7px; border:1px solid #dfe4ef; background:#fff; border-radius:20px;
              padding:5px 11px 5px 6px; font-size:12px; color:#59617a; cursor:pointer; transition:all .15s; max-width:100%; }
    .agc-cb:hover:not(:disabled) { border-color:var(--primary); }
    .agc-cb:disabled { cursor:not-allowed; opacity:.75; }
    .agc-cb.on { border-color:var(--primary); background:var(--primary-soft); color:var(--primary); font-weight:700; }
    .agc-check { width:18px; height:18px; border-radius:50%; border:1.5px solid #c9d0e0; display:flex; align-items:center;
                 justify-content:center; font-size:11px; flex-shrink:0; background:#fff; }
    .agc-cb.on .agc-check { border-color:var(--primary); background:var(--primary); color:#fff; }
    .agc-cb-n { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .agc-cb-c { font-size:10.5px; color:#9aa3bd; font-weight:600; }
    .agc-ayuda { font-size:11.5px; color:#8a93ad; margin-top:6px; }
    .agc-vacio { font-size:12px; color:#9aa3bd; font-style:italic; }

    /* Chat con el agente */
    .agc-chat { border:1px solid #e6e9f2; border-radius:12px; overflow:hidden; background:#f8f9fc; }
    .agc-msgs { max-height:360px; min-height:90px; overflow:auto; padding:12px; display:flex; flex-direction:column; gap:8px; }
    .agc-msg { max-width:88%; padding:8px 12px; border-radius:12px; font-size:13px; line-height:1.55; white-space:pre-wrap; overflow-wrap:anywhere; }
    .agc-msg.yo { align-self:flex-end; background:var(--primary); color:#fff; border-bottom-right-radius:4px; }
    .agc-msg.bot { align-self:flex-start; background:#fff; color:#2a2f3d; border:1px solid #e6e9f2; border-bottom-left-radius:4px; white-space:normal; }
    .agc-md p { margin:.35em 0; } .agc-md ul, .agc-md ol { margin:.35em 0; padding-left:1.3em; }
    .agc-md h1, .agc-md h2, .agc-md h3 { font-size:14px; font-weight:800; margin:.6em 0 .3em; }
    .agc-md code { font-size:12px; background:#f1f3f8; padding:1px 4px; border-radius:4px; }
    .agc-md table { border-collapse:collapse; font-size:12px; } .agc-md th, .agc-md td { border:1px solid #e6e9f2; padding:4px 7px; }
    .agc-pensando { display:flex; align-items:center; gap:4px; padding:12px 14px; }
    .agc-pensando em { font-size:11.5px; color:#8a93ad; margin-left:6px; }
    .agc-chat-h { display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap; }
    .agc-modo { display:inline-flex; background:#eef1f7; border-radius:9px; padding:2px; gap:2px; margin-bottom:6px; }
    .agc-modo button { border:0; background:transparent; border-radius:7px; padding:4px 10px; font-size:11.5px; font-weight:700; color:#59617a; cursor:pointer; }
    .agc-modo button.on { background:#fff; color:var(--primary); box-shadow:0 1px 3px rgba(0,0,0,.08); }
    .agc-modo button:disabled { cursor:not-allowed; }
    .agc-modo button:disabled:not(.on) { opacity:.6; }
    .agc-pensando span { width:7px; height:7px; border-radius:50%; background:#b3bad0; animation:agc-pt 1.2s infinite ease-in-out; }
    .agc-pensando span:nth-child(2) { animation-delay:.2s; } .agc-pensando span:nth-child(3) { animation-delay:.4s; }
    @@keyframes agc-pt { 0%, 80%, 100% { opacity:.3; transform:translateY(0); } 40% { opacity:1; transform:translateY(-3px); } }
    .agc-error { font-size:12px; color:#b02a1a; background:#fdecea; padding:7px 12px; }
    .agc-in { display:flex; gap:8px; align-items:flex-end; padding:9px; background:#fff; border-top:1px solid #e6e9f2; }
    .agc-in textarea { flex:1; border:1px solid #dfe4ef; border-radius:9px; padding:7px 10px; font-size:13px; resize:vertical; min-height:40px; font-family:inherit; outline:none; }
    .agc-in textarea:focus { border-color:var(--primary); }
    .agc-in-acc { display:flex; gap:6px; }
    /* Fuentes de cada respuesta del agente */
    .agc-fuentes { align-self:flex-start; max-width:88%; margin:-2px 0 4px 4px; display:flex; flex-direction:column; gap:5px; }
    .agc-f-fila { display:flex; flex-wrap:wrap; align-items:center; gap:5px; }
    .agc-f-t { font-size:10px; font-weight:800; text-transform:uppercase; letter-spacing:.04em; color:#8a93ad; margin-right:2px; }
    .agc-f { font-size:11.5px; padding:2px 9px; border-radius:20px; border:1px solid #dfe4ef; background:#fff; color:#59617a; text-decoration:none; max-width:100%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .agc-f:hover { border-color:var(--primary); color:var(--primary); }
    .agc-f.leida { background:var(--primary-soft); border-color:color-mix(in srgb, var(--primary) 35%, transparent); color:var(--primary); font-weight:700; }
    .agc-f-alerta { font-size:11.5px; color:#8a5a00; background:#fff6e0; border:1px solid #f3d39a; border-radius:8px; padding:5px 9px; }
    .agc-f-alerta.suave { color:#6b7491; background:#f4f6fb; border-color:#e3e7f2; }
    .agc-f-mas summary { font-size:11px; color:#8a93ad; cursor:pointer; }
    .agc-f-mas .agc-f-fila { margin-top:5px; }
</style>

@code {
    private sealed record AgenteVista(AiAgentDto Agent, IReadOnlyList<AiAgentPromptDto> Prompts);

    private List<AgenteVista> _agentes = new();
    private bool _cargando = true, _guardando;
    private string? _error, _ok;

    private Guid? _editMisionId;
    private string _misionTexto = "";
    private Guid? _promptAbierto;
    private string _promptTexto = "";

    private AiUsageSummaryDto _consumo = new(0, 0, 0, 0, 0m, []);
    private AiQuotaDto _cupo = new(0, 0, false);

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await CargarConsumo();
        await CargarAgentes();
        _esAdmin = await Cerebros.EsAdminAsync();
        _motores = (await AgenteCerebros.MotoresAsync()).ToList();
        try { await CargarCerebrosAgentes(); }
        catch (InvalidOperationException ex) { _error = ex.Message; }
    }

    private async Task CargarConsumo()
    {
        _consumo = await Consumo.GetSummaryAsync();
        _cupo = await Consumo.GetQuotaAsync();
    }

    private async Task CargarAgentes()
    {
        _cargando = true;
        try
        {
            var lista = await Agentes.ListAsync();
            var vistas = new List<AgenteVista>();
            foreach (var a in lista)
            {
                var det = await Agentes.GetAsync(a.Id);
                vistas.Add(new AgenteVista(a, det?.Prompts ?? Array.Empty<AiAgentPromptDto>()));
            }
            // El de generacion primero (es el protagonista del modulo).
            _agentes = vistas.OrderByDescending(v => EsGeneracion(v.Agent)).ThenBy(v => v.Agent.Name).ToList();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _cargando = false; }
    }

    private static bool EsGeneracion(AiAgentDto a) => a.Role == "procedimientos-trd";

    private static string RolLabel(string? role) => role switch
    {
        "procedimientos-trd" => "Generacion - arma el procedimiento por segmentos",
        "clasificador-trd" => "Revision - sugiere la clasificacion de la TRD",
        _ => string.IsNullOrWhiteSpace(role) ? "Agente" : role
    };

    private static string Resumen(string? texto)
    {
        var t = (texto ?? "").Trim();
        return t.Length <= 320 ? t : t[..320] + "...";
    }

    private void EditarMision(AiAgentDto a)
    {
        _editMisionId = a.Id;
        _misionTexto = a.SystemPrompt;
        _ok = _error = null;
    }

    private async Task GuardarMision(AiAgentDto a)
    {
        _ok = _error = null;
        if (string.IsNullOrWhiteSpace(_misionTexto)) { _error = "La mision no puede quedar vacia."; return; }
        _guardando = true;
        try
        {
            await Agentes.UpdateAsync(a.Id, new UpdateAiAgentRequest(a.Name, a.Role, a.Provider, a.Model, _misionTexto), await Actor());
            _editMisionId = null;
            _ok = "Mision guardada.";
            await CargarAgentes();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _guardando = false; }
    }

    private List<MotorIaDto> _motores = new();
    private Dictionary<Guid, string> _modos = new();

    private async Task FijarModo(AiAgentDto a, string modo)
    {
        if (_modos.GetValueOrDefault(a.Id) == modo) { return; }
        _ok = _error = null;
        _guardando = true;
        try
        {
            await AgenteCerebros.FijarModoAsync(a.Id, modo);
            _modos[a.Id] = modo;
            _ok = modo == "profundo" ? $"{a.Name} investigara a fondo sus cerebros." : $"{a.Name} respondera en modo rapido.";
        }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        finally { _guardando = false; }
    }

    private async Task FijarMotor(AiAgentDto a, AiProvider provider)
    {
        if (a.Provider == provider) { return; }
        _ok = _error = null;
        _guardando = true;
        try
        {
            await AgenteCerebros.FijarMotorAsync(a.Id, provider);
            _ok = $"{a.Name} ahora usa {_motores.First(m => m.Provider == provider).Nombre}.";
            await CargarAgentes();
        }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        finally { _guardando = false; }
    }

    private void TogglePrompt(Guid promptId)
    {
        if (_promptAbierto == promptId) { _promptAbierto = null; return; }
        _promptAbierto = promptId;
        _promptTexto = _agentes.SelectMany(a => a.Prompts).FirstOrDefault(p => p.Id == promptId)?.Body ?? "";
        _ok = _error = null;
    }

    private async Task GuardarPrompt(AiAgentDto a, AiAgentPromptDto p)
    {
        _ok = _error = null;
        if (string.IsNullOrWhiteSpace(_promptTexto)) { _error = "El prompt no puede quedar vacio."; return; }
        _guardando = true;
        try
        {
            await Agentes.UpdatePromptAsync(p.Id, new UpdateAgentPromptRequest(p.Name, p.Rule, _promptTexto), await Actor());
            _promptAbierto = null;
            _ok = "Paso guardado.";
            await CargarAgentes();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _guardando = false; }
    }

    private async Task<Guid> Actor()
    {
        if (AuthState is null) { return Guid.Empty; }
        var st = await AuthState;
        return Guid.TryParse(st.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : Guid.Empty;
    }

    private static string Tokens(long n) => n >= 1000 ? $"{n / 1000.0:0.#}k" : n.ToString();

    // ------------------------------------------------ cerebros del agente y chat

    private bool _esAdmin;
    private Dictionary<Guid, List<CerebroDeAgenteDto>> _cerebrosPorAgente = new();
    private readonly Dictionary<Guid, ChatAgente> _chats = new();
    private static readonly HashSet<string> _sinClaves = new();

    /// <summary>Un mensaje del chat; Fuentes solo en respuestas del agente con cerebros.</summary>
    private sealed record MensajeChat(string Role, string Text, IReadOnlyList<FuenteNotaDto>? Fuentes = null);

    private sealed class ChatAgente
    {
        public List<MensajeChat> Mensajes { get; } = new();
        public string Texto { get; set; } = "";
        public bool Ocupado { get; set; }
        public string? Error { get; set; }
        public void Limpiar() { Mensajes.Clear(); Error = null; }
    }

    private ChatAgente Chat(Guid agentId)
    {
        if (!_chats.TryGetValue(agentId, out var c)) { c = new ChatAgente(); _chats[agentId] = c; }
        return c;
    }

    private async Task CargarCerebrosAgentes()
    {
        var mapa = new Dictionary<Guid, List<CerebroDeAgenteDto>>();
        foreach (var a in _agentes)
        {
            mapa[a.Agent.Id] = (await AgenteCerebros.CerebrosAsync(a.Agent.Id)).ToList();
        }
        _cerebrosPorAgente = mapa;
        var modos = new Dictionary<Guid, string>();
        foreach (var a in _agentes) { modos[a.Agent.Id] = await AgenteCerebros.ModoAsync(a.Agent.Id); }
        _modos = modos;
    }

    private async Task AlternarCerebro(Guid agentId, CerebroDeAgenteDto c)
    {
        _ok = _error = null;
        try
        {
            await AgenteCerebros.FijarAsync(agentId, c.Id, !c.Seleccionado);
            _cerebrosPorAgente[agentId] = (await AgenteCerebros.CerebrosAsync(agentId)).ToList();
        }
        catch (InvalidOperationException ex) { _error = ex.Message; }
    }

    private async Task TeclaChat(KeyboardEventArgs e, Guid agentId)
    {
        if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey)) { await EnviarChat(agentId); }
    }

    private async Task EnviarChat(Guid agentId)
    {
        var chat = Chat(agentId);
        var texto = chat.Texto.Trim();
        if (texto.Length == 0 || chat.Ocupado) { return; }
        chat.Error = null;
        chat.Mensajes.Add(new MensajeChat("user", texto));
        chat.Texto = "";
        chat.Ocupado = true;
        StateHasChanged();
        await BajarChat(agentId);
        try
        {
            // Se mandan los ultimos 20 turnos: suficiente contexto sin crecer sin limite.
            var turnos = chat.Mensajes.TakeLast(20).Select(m => new AiChatTurn(m.Role, m.Text)).ToList();
            var res = await Inferencia.ConversarAsync(agentId, turnos);
            if (res.Ok && !string.IsNullOrWhiteSpace(res.Text)) { chat.Mensajes.Add(new MensajeChat("model", res.Text!, res.Fuentes)); }
            else { chat.Error = res.Error ?? "El agente no respondio; intenta de nuevo."; }
            await CargarConsumo();
        }
        catch (Exception ex) { chat.Error = "No se pudo hablar con el agente: " + ex.Message; }
        finally { chat.Ocupado = false; }
        StateHasChanged();
        await BajarChat(agentId);
    }

    private async Task BajarChat(Guid agentId)
    {
        try { await JS.InvokeVoidAsync("cerebroGrafo.bajar", $"agc-msgs-{agentId:N}"); }
        catch (JSException) { }
    }
}
