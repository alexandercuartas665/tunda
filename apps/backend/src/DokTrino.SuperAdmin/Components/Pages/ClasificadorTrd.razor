@page "/clasificador-trd"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using DokTrino.Application.Tenancy
@using System.Security.Claims
@inject IAiUsageService Consumo
@inject IAiAgentService Agentes

<PageTitle>Agentes TRD - Archimente</PageTitle>

@* --- Hero con la mascota: le da cara a los agentes de IA del modulo --- *@
<div class="clia-hero">
    <img class="clia-mascota" src="/img/marca/mascota-superheroe.png" alt="" aria-hidden="true" />
    <div class="clia-hero-txt">
        <div class="clia-eyebrow">IA Documental &middot; Archimente</div>
        <h1 class="clia-title">Agentes de la TRD</h1>
        <p class="clia-sub">
            Cada agente tiene una mision y un conjunto de prompts (los pasos en que se divide su trabajo).
            El de <b>generacion</b> arma el procedimiento por segmentos; podras ejecutar cada paso por separado
            desde el documento en <b>Transacciones documentales</b>.
        </p>
    </div>
</div>

@* --- Consumo de IA del tenant --- *@
<div class="clia-kpis">
    <div class="clia-kpi">
        <div class="k">Tokens consumidos</div>
        <div class="v">@Tokens(_consumo.TotalTokens)</div>
        <div class="h">@Tokens(_consumo.InputTokens) entrada &middot; @Tokens(_consumo.OutputTokens) salida</div>
    </div>
    <div class="clia-kpi">
        <div class="k">Llamadas de IA</div>
        <div class="v">@_consumo.TotalCalls</div>
    </div>
    <div class="clia-kpi">
        <div class="k">Costo estimado</div>
        <div class="v">$@_consumo.EstimatedCostUsd.ToString("0.####")</div>
        <div class="h">USD, aproximado por tarifa del proveedor</div>
    </div>
    @if (_cupo.HasLimit)
    {
        <div class="clia-kpi">
            <div class="k">Cupo mensual</div>
            <div class="v">@_cupo.UsedPct%</div>
            <div class="clia-bar"><span style="width:@(_cupo.UsedPct)%"></span></div>
            <div class="h">@Tokens(_cupo.MonthlyUsedTokens) / @Tokens(_cupo.MonthlyLimitTokens) tokens</div>
        </div>
    }
</div>

@if (_error is not null) { <div class="ase-alert">@_error</div> }
@if (_ok is not null) { <div class="ase-ok">@_ok</div> }

@if (_cargando)
{
    <div class="ase-card"><div class="dep-ind-load">Cargando agentes...</div></div>
}
else if (_agentes.Count == 0)
{
    <div class="ase-card">
        <div class="ase-card-h">Sin agentes todavia</div>
        <p class="text-muted" style="margin:0;">
            El agente de <b>generacion de procedimientos</b> se crea solo la primera vez que generas
            un procedimiento desde una fila de la TRD (Transacciones documentales). Vuelve aqui y lo veras
            como tarjeta con sus pasos.
        </p>
    </div>
}
else
{
    <div class="ag-grid">
        @foreach (var a in _agentes)
        {
            <div class="ag-card @(EsGeneracion(a.Agent) ? "gen" : "")">
                <div class="ag-card-h">
                    <img class="ag-ic" src="/img/marca/mascota-superheroe.png" alt="" aria-hidden="true" />
                    <div class="ag-id">
                        <div class="ag-nom">@a.Agent.Name</div>
                        <div class="ag-rol">@RolLabel(a.Agent.Role)</div>
                    </div>
                    <span class="ag-estado @(a.Agent.IsActive ? "on" : "off")">@(a.Agent.IsActive ? "Activo" : "Inactivo")</span>
                </div>

                <div class="ag-sec-t">Mision</div>
                @if (_editMisionId == a.Agent.Id)
                {
                    <textarea class="form-control ag-ta" rows="6" @bind="_misionTexto"></textarea>
                    <div class="ag-btns">
                        <button class="btn btn-primary btn-sm" @onclick="() => GuardarMision(a.Agent)" disabled="@_guardando">Guardar mision</button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => _editMisionId = null" disabled="@_guardando">Cancelar</button>
                    </div>
                }
                else
                {
                    <div class="ag-mision">@Resumen(a.Agent.SystemPrompt)</div>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => EditarMision(a.Agent)">Editar mision</button>
                }

                @if (a.Prompts.Count > 0)
                {
                    <div class="ag-sec-t">Pasos / prompts (@a.Prompts.Count)</div>
                    <div class="ag-pasos">
                        @foreach (var p in a.Prompts.OrderBy(x => x.SortOrder))
                        {
                            <div class="ag-paso">
                                <div class="ag-paso-h" @onclick="() => TogglePrompt(p.Id)">
                                    <span class="ag-paso-n">@p.SortOrder</span>
                                    <span class="ag-paso-nom">@p.Name</span>
                                    <span class="ag-caret">@((MarkupString)(_promptAbierto == p.Id ? "&#9662;" : "&#9656;"))</span>
                                </div>
                                @if (_promptAbierto == p.Id)
                                {
                                    <textarea class="form-control ag-ta" rows="7" @bind="_promptTexto"></textarea>
                                    <div class="ag-btns">
                                        <button class="btn btn-primary btn-sm" @onclick="() => GuardarPrompt(a.Agent, p)" disabled="@_guardando">Guardar paso</button>
                                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => _promptAbierto = null" disabled="@_guardando">Cerrar</button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    @if (EsGeneracion(a.Agent))
                    {
                        <div class="ag-nota">
                            Para <b>ejecutar cada paso por separado</b>, abre el procedimiento de una fila en
                            Transacciones documentales: alli estan los botones <i>Que es &middot; Elimina &middot; Conserva &middot; Unificar</i>.
                        </div>
                    }
                }
            </div>
        }
    </div>
}

<style>
    /* Hero con mascota */
    .clia-hero { position: relative; overflow: hidden; display: flex; align-items: center; gap: 20px;
                 background: linear-gradient(135deg, var(--primary-deep), var(--primary)); color: #fff;
                 border-radius: 18px; padding: 20px 26px; margin-bottom: 16px; box-shadow: 0 14px 36px var(--primary-shadow); }
    .clia-mascota { height: 118px; width: auto; flex-shrink: 0; filter: drop-shadow(0 8px 16px rgba(0,0,0,.28)); }
    @@media (max-width: 640px) { .clia-mascota { display: none; } }
    .clia-eyebrow { font-size: 10.5px; font-weight: 800; letter-spacing: .5px; text-transform: uppercase; opacity: .85; }
    .clia-title { font-size: 1.7rem; font-weight: 800; letter-spacing: -.02em; margin: 3px 0 6px; }
    .clia-sub { font-size: 13px; line-height: 1.6; color: rgba(255,255,255,.92); margin: 0; max-width: 760px; }

    /* KPIs de consumo */
    .clia-kpis { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 12px; margin-bottom: 16px; }
    @@media (max-width: 900px) { .clia-kpis { grid-template-columns: repeat(2, minmax(0,1fr)); } }
    .clia-kpi { background: #fff; border: 1px solid #e6e9f2; border-radius: 12px; padding: 13px 15px; }
    .clia-kpi .k { font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .3px; color: #8a93ad; }
    .clia-kpi .v { font-size: 1.5rem; font-weight: 800; color: #1f2433; letter-spacing: -.02em; margin: 2px 0; }
    .clia-kpi .h { font-size: 11px; color: #9aa3bd; }
    .clia-bar { height: 6px; border-radius: 6px; background: #eef1f7; overflow: hidden; margin: 4px 0; }
    .clia-bar span { display: block; height: 100%; background: var(--primary); }

    /* Tarjetas de agentes */
    .ag-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 14px; }
    @@media (max-width: 900px) { .ag-grid { grid-template-columns: 1fr; } }
    .ag-card { background:#fff; border:1px solid #e6e9f2; border-radius:14px; padding:16px 18px; }
    .ag-card.gen { border-color:var(--primary); box-shadow:0 8px 22px var(--primary-shadow); }
    .ag-card-h { display:flex; align-items:center; gap:11px; }
    .ag-ic { height:44px; width:auto; }
    .ag-id { flex:1; min-width:0; }
    .ag-nom { font-size:15px; font-weight:800; color:#1f2433; }
    .ag-rol { font-size:12px; color:#6b7593; }
    .ag-estado { font-size:10px; font-weight:800; padding:2px 8px; border-radius:20px; }
    .ag-estado.on { background:#e8f5ee; color:#2f7d54; }
    .ag-estado.off { background:#f1f3f8; color:#9aa3bd; }
    .ag-sec-t { font-size:11px; font-weight:700; color:#1f2433; text-transform:uppercase; letter-spacing:.4px; margin:14px 0 7px; }
    .ag-mision { font-size:12.5px; line-height:1.6; color:#59617a; white-space:pre-wrap; max-height:120px; overflow:auto; margin-bottom:8px; }
    .ag-ta { font-family:'JetBrains Mono','Consolas',monospace; font-size:12px; line-height:1.55; }
    .ag-btns { display:flex; gap:8px; margin-top:8px; flex-wrap:wrap; }
    .ag-pasos { display:flex; flex-direction:column; gap:6px; }
    .ag-paso { border:1px solid #eef1f7; border-radius:9px; overflow:hidden; }
    .ag-paso-h { display:flex; align-items:center; gap:9px; padding:8px 11px; cursor:pointer; user-select:none; }
    .ag-paso-h:hover { background:#f6f8fc; }
    .ag-paso-n { width:20px; height:20px; border-radius:6px; background:var(--primary-soft); color:var(--primary);
                 font-size:11px; font-weight:800; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .ag-paso-nom { flex:1; font-size:12.5px; font-weight:600; color:#2a2f3d; }
    .ag-caret { color:var(--primary); font-size:11px; }
    .ag-paso .ag-ta { margin:0 11px 11px; width:calc(100% - 22px); }
    .ag-paso .ag-btns { padding:0 11px 11px; margin-top:0; }
    .ag-nota { font-size:12px; color:#59617a; background:#f6f8fc; border-radius:9px; padding:9px 11px; margin-top:10px; }
    .ase-card { background:#fff; border:1px solid #e6e9f2; border-radius:14px; padding:16px 18px; margin-bottom:14px; }
    .ase-card-h { font-size:14px; font-weight:800; color:#1f2433; margin-bottom:8px; }
    .ase-alert { background:#fdecea; color:#b02a1a; border-radius:10px; padding:10px 13px; margin-bottom:12px; font-size:13px; }
    .ase-ok { background:#e8f5ee; color:#2f7d54; border-radius:10px; padding:10px 13px; margin-bottom:12px; font-size:13px; }
    .dep-ind-load { color:#9aa3bd; font-style:italic; }
</style>

@code {
    private sealed record AgenteVista(AiAgentDto Agent, IReadOnlyList<AiAgentPromptDto> Prompts);

    private List<AgenteVista> _agentes = new();
    private bool _cargando = true, _guardando;
    private string? _error, _ok;

    private Guid? _editMisionId;
    private string _misionTexto = "";
    private Guid? _promptAbierto;
    private string _promptTexto = "";

    private AiUsageSummaryDto _consumo = new(0, 0, 0, 0, 0m, []);
    private AiQuotaDto _cupo = new(0, 0, false);

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await CargarConsumo();
        await CargarAgentes();
    }

    private async Task CargarConsumo()
    {
        _consumo = await Consumo.GetSummaryAsync();
        _cupo = await Consumo.GetQuotaAsync();
    }

    private async Task CargarAgentes()
    {
        _cargando = true;
        try
        {
            var lista = await Agentes.ListAsync();
            var vistas = new List<AgenteVista>();
            foreach (var a in lista)
            {
                var det = await Agentes.GetAsync(a.Id);
                vistas.Add(new AgenteVista(a, det?.Prompts ?? Array.Empty<AiAgentPromptDto>()));
            }
            // El de generacion primero (es el protagonista del modulo).
            _agentes = vistas.OrderByDescending(v => EsGeneracion(v.Agent)).ThenBy(v => v.Agent.Name).ToList();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _cargando = false; }
    }

    private static bool EsGeneracion(AiAgentDto a) => a.Role == "procedimientos-trd";

    private static string RolLabel(string? role) => role switch
    {
        "procedimientos-trd" => "Generacion - arma el procedimiento por segmentos",
        "clasificador-trd" => "Revision - sugiere la clasificacion de la TRD",
        _ => string.IsNullOrWhiteSpace(role) ? "Agente" : role
    };

    private static string Resumen(string? texto)
    {
        var t = (texto ?? "").Trim();
        return t.Length <= 320 ? t : t[..320] + "...";
    }

    private void EditarMision(AiAgentDto a)
    {
        _editMisionId = a.Id;
        _misionTexto = a.SystemPrompt;
        _ok = _error = null;
    }

    private async Task GuardarMision(AiAgentDto a)
    {
        _ok = _error = null;
        if (string.IsNullOrWhiteSpace(_misionTexto)) { _error = "La mision no puede quedar vacia."; return; }
        _guardando = true;
        try
        {
            await Agentes.UpdateAsync(a.Id, new UpdateAiAgentRequest(a.Name, a.Role, a.Provider, a.Model, _misionTexto), await Actor());
            _editMisionId = null;
            _ok = "Mision guardada.";
            await CargarAgentes();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _guardando = false; }
    }

    private void TogglePrompt(Guid promptId)
    {
        if (_promptAbierto == promptId) { _promptAbierto = null; return; }
        _promptAbierto = promptId;
        _promptTexto = _agentes.SelectMany(a => a.Prompts).FirstOrDefault(p => p.Id == promptId)?.Body ?? "";
        _ok = _error = null;
    }

    private async Task GuardarPrompt(AiAgentDto a, AiAgentPromptDto p)
    {
        _ok = _error = null;
        if (string.IsNullOrWhiteSpace(_promptTexto)) { _error = "El prompt no puede quedar vacio."; return; }
        _guardando = true;
        try
        {
            await Agentes.UpdatePromptAsync(p.Id, new UpdateAgentPromptRequest(p.Name, p.Rule, _promptTexto), await Actor());
            _promptAbierto = null;
            _ok = "Paso guardado.";
            await CargarAgentes();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _guardando = false; }
    }

    private async Task<Guid> Actor()
    {
        if (AuthState is null) { return Guid.Empty; }
        var st = await AuthState;
        return Guid.TryParse(st.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : Guid.Empty;
    }

    private static string Tokens(long n) => n >= 1000 ? $"{n / 1000.0:0.#}k" : n.ToString();
}
