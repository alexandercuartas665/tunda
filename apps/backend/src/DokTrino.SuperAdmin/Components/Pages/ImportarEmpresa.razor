@page "/importar-empresa"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Security.Claims
@using DokTrino.Application.Tenancy
@inject IImportacionEntreEmpresasService Svc

<PageTitle>Importar de otra empresa - Archimente</PageTitle>

<div class="module-head">
    <div>
        <div class="module-eyebrow">
            <div class="module-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>
            </div>
            <span>Configuracion</span>
        </div>
        <h1 class="page-title" style="margin-top:12px;">Importar de otra empresa</h1>
        <p class="page-sub" style="margin-bottom:0;">Copia agentes de IA, formacion o el catalogo documental desde otra de tus empresas hacia la empresa actual. Solo aparecen empresas donde eres miembro.</p>
    </div>
</div>

@if (_msg is not null)
{
    <div class="card" style="max-width:1040px;border-left:4px solid @(_ok ? "#16a34a" : "#dc2626");padding:12px 16px;margin-bottom:16px;">
        <span style="color:@(_ok ? "#166534" : "#b91c1c");font-weight:600;">@_msg</span>
    </div>
}

@if (_empresas is null)
{
    <p><em>Cargando...</em></p>
}
else if (_empresas.Count == 0)
{
    <div class="card" style="max-width:1040px;padding:18px;">
        <p class="text-muted" style="margin:0;">No perteneces a otra empresa desde la cual copiar. Cuando seas miembro de mas de una empresa, aqui podras traer su configuracion.</p>
    </div>
}
else
{
    <div class="card" style="max-width:1040px;padding:16px;margin-bottom:18px;">
        <label class="form-label">Empresa origen</label>
        <select class="form-control" style="max-width:420px;" @onchange="OnOrigenChanged">
            <option value="@Guid.Empty">-- Selecciona una empresa --</option>
            @foreach (var e in _empresas)
            {
                <option value="@e.TenantId" selected="@(e.TenantId == _origen)">@e.Nombre</option>
            }
        </select>
    </div>

    @if (_origen != Guid.Empty)
    {
        <div class="card" style="max-width:1040px;padding:6px 16px;margin-bottom:16px;">
            <h3 style="margin:12px 4px;">Agentes IA</h3>
            @if (_agentes is null) { <p style="margin:4px;"><em>Cargando...</em></p> }
            else if (_agentes.Count == 0) { <p class="text-muted" style="margin:4px 4px 14px;">Esta empresa no tiene agentes.</p> }
            else
            {
                <table class="table align-middle" style="margin-bottom:8px;">
                    <thead><tr><th>Agente</th><th>Rol</th><th>Contenido</th><th>Estado</th><th class="text-end">Accion</th></tr></thead>
                    <tbody>
                        @foreach (var a in _agentes)
                        {
                            <tr>
                                <td style="font-weight:600;">@a.Nombre</td>
                                <td>@(a.Rol ?? "-")</td>
                                <td class="text-muted">@a.Prompts prompt(s) &middot; @a.Recursos recurso(s)</td>
                                <td>@(a.Activo ? "Activo" : "Apagado")</td>
                                <td class="text-end"><button class="btn btn-sm btn-primary" disabled="@_busy" @onclick="() => ImportarAgente(a.Id)">Importar</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="card" style="max-width:1040px;padding:6px 16px;margin-bottom:16px;">
            <h3 style="margin:12px 4px;">Formacion</h3>
            @if (_cursos is null) { <p style="margin:4px;"><em>Cargando...</em></p> }
            else if (_cursos.Count == 0) { <p class="text-muted" style="margin:4px 4px 14px;">Esta empresa no tiene cursos.</p> }
            else
            {
                <table class="table align-middle" style="margin-bottom:8px;">
                    <thead><tr><th>Curso</th><th>Contenido</th><th>Evaluacion</th><th>Estado</th><th class="text-end">Accion</th></tr></thead>
                    <tbody>
                        @foreach (var c in _cursos)
                        {
                            <tr>
                                <td style="font-weight:600;">@c.Titulo</td>
                                <td class="text-muted">@c.Modulos modulo(s) &middot; @c.Lecciones leccion(es)</td>
                                <td>@(c.TieneEvaluacion ? "Si" : "No")</td>
                                <td>@(c.Activo ? "Activo" : "Apagado")</td>
                                <td class="text-end"><button class="btn btn-sm btn-primary" disabled="@_busy" @onclick="() => ImportarCurso(c.Id)">Importar</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="card" style="max-width:1040px;padding:16px;margin-bottom:16px;">
            <h3 style="margin:4px 4px 10px;">Catalogo documental (series maestras)</h3>
            @if (_catalogo is null) { <p style="margin:4px;"><em>Cargando...</em></p> }
            else if (_catalogo.Series == 0) { <p class="text-muted" style="margin:4px;">Esta empresa no tiene catalogo maestro.</p> }
            else
            {
                <p class="text-muted" style="margin:0 4px 12px;">@_catalogo.Series serie(s), @_catalogo.Subseries subserie(s) y @_catalogo.Tipologias tipologia(s). Las series cuyo codigo ya exista en la empresa actual se omiten.</p>
                <button class="btn btn-primary" disabled="@_busy" @onclick="ImportarCatalogo">Importar catalogo completo</button>
            }
        </div>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<EmpresaOrigenDto>? _empresas;
    private Guid _origen = Guid.Empty;
    private IReadOnlyList<AgenteOrigenDto>? _agentes;
    private IReadOnlyList<CursoOrigenDto>? _cursos;
    private CatalogoOrigenDto? _catalogo;

    private bool _busy;
    private string? _msg;
    private bool _ok;

    protected override async Task OnInitializedAsync()
    {
        _empresas = await Svc.EmpresasOrigenAsync(await ActorAsync());
    }

    private async Task OnOrigenChanged(ChangeEventArgs e)
    {
        _msg = null;
        _agentes = null; _cursos = null; _catalogo = null;
        if (!Guid.TryParse(e.Value?.ToString(), out _origen) || _origen == Guid.Empty)
        {
            _origen = Guid.Empty;
            return;
        }
        var actor = await ActorAsync();
        _agentes = await Svc.AgentesAsync(_origen, actor);
        _cursos = await Svc.CursosAsync(_origen, actor);
        _catalogo = await Svc.CatalogoResumenAsync(_origen, actor);
    }

    private async Task ImportarAgente(Guid id) => await EjecutarAsync(a => Svc.ImportarAgenteAsync(_origen, id, a));
    private async Task ImportarCurso(Guid id) => await EjecutarAsync(a => Svc.ImportarCursoAsync(_origen, id, a));
    private async Task ImportarCatalogo() => await EjecutarAsync(a => Svc.ImportarCatalogoAsync(_origen, a));

    private async Task EjecutarAsync(Func<Guid, Task<ImportOutcome>> accion)
    {
        _busy = true;
        _msg = null;
        try
        {
            var res = await accion(await ActorAsync());
            _ok = res.Success;
            _msg = res.Mensaje;
        }
        catch (Exception ex)
        {
            _ok = false;
            _msg = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<Guid> ActorAsync()
    {
        if (AuthState is null) { return Guid.Empty; }
        var st = await AuthState;
        return Guid.TryParse(st.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : Guid.Empty;
    }
}
