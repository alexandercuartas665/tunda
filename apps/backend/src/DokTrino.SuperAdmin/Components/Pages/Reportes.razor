@page "/reportes"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using DokTrino.Application.Tenancy
@inject ITrdAdminService Trd
@inject NavigationManager Nav

<PageTitle>Reportes - Archimente</PageTitle>

<div class="ase-head">
    <div>
        <div class="ase-eyebrow">Analitica</div>
        <h1 class="ase-title">Galeria de reportes</h1>
        <p class="page-sub" style="margin:2px 0 0;">Elige un reporte. Cada uno se puede descargar en Excel o PDF.</p>
    </div>
</div>

<div class="rep-gallery">
    @* ===== Indicadores de gestion (nuevo) ===== *@
    <button type="button" class="rep-tile rep-tile-feat" @onclick="AbrirIndicadores">
        <div class="rep-tile-top">
            <div class="rep-tile-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
            </div>
            <span class="rep-tile-tag">Excel &middot; PDF</span>
        </div>
        <h3 class="rep-tile-h">Indicadores de gestion</h3>
        <p class="rep-tile-p">Ingresos a la plataforma, capacitacion cursada y documentos cargados, con graficas y filtros por TRD, dependencia, serie y fechas.</p>
        <span class="rep-tile-cta">Abrir reporte &#8594;</span>
    </button>

    @* ===== Usuarios por TRD (existente) ===== *@
    <button type="button" class="rep-tile @(_verUsuarios ? "is-active" : "")" @onclick="() => _verUsuarios = !_verUsuarios">
        <div class="rep-tile-top">
            <div class="rep-tile-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <span class="rep-tile-tag">Excel</span>
        </div>
        <h3 class="rep-tile-h">Usuarios por transaccion (TRD)</h3>
        <p class="rep-tile-p">Colaboradores de cada TRD: empresa, dependencia, codigo, nombre, correo, telefono, rol y la URL del enlace de cada persona.</p>
        <span class="rep-tile-cta">@(_verUsuarios ? "Ocultar listado" : "Ver listado") &#8594;</span>
    </button>
</div>

@if (_verUsuarios)
{
    <div class="ase-card" style="margin-top:16px;">
        <div class="ase-card-h">Listado de usuarios por transaccion (TRD)</div>
        @if (_trds is null)
        {
            <p><em>Cargando...</em></p>
        }
        else if (_trds.Count == 0)
        {
            <div class="ase-empty">No hay transacciones (TRD) todavia.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle" style="max-width:760px;">
                    <thead>
                        <tr><th>TRD</th><th>Titulo</th><th>Estado</th><th class="text-center">Dependencias</th><th class="text-end">Reporte</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var t in _trds)
                        {
                            <tr>
                                <td class="mono">@t.Consecutivo</td>
                                <td>@t.Titulo</td>
                                <td>@t.Estado</td>
                                <td class="text-center">@t.Dependencias</td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-primary" href="@($"/api/doktrino/trd/{t.Id}/usuarios-excel")" target="_blank">&#8681; Excel</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

<style>
    .rep-gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 16px; }
    .rep-tile {
        text-align: left; background: var(--card); border: 1px solid var(--border);
        border-radius: 14px; padding: 18px; cursor: pointer; display: flex; flex-direction: column;
        gap: 8px; transition: border-color .15s, box-shadow .15s, transform .15s; min-height: 190px;
        color: var(--foreground); font: inherit;
    }
    .rep-tile:hover { border-color: var(--primary); box-shadow: var(--shadow-soft, 0 6px 20px rgba(0,0,0,.06)); transform: translateY(-2px); }
    .rep-tile.is-active { border-color: var(--primary); }
    .rep-tile-feat { background: linear-gradient(180deg, color-mix(in srgb, var(--primary) 7%, var(--card)), var(--card)); }
    .rep-tile-top { display: flex; align-items: center; justify-content: space-between; }
    .rep-tile-ico {
        width: 40px; height: 40px; border-radius: 10px; display: grid; place-items: center;
        background: color-mix(in srgb, var(--primary) 12%, transparent); color: var(--primary);
    }
    .rep-tile-ico svg { width: 22px; height: 22px; }
    .rep-tile-tag {
        font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em;
        color: var(--primary); background: color-mix(in srgb, var(--primary) 10%, transparent);
        padding: 3px 9px; border-radius: 999px;
    }
    .rep-tile-h { font-size: 15px; font-weight: 700; margin: 2px 0 0; }
    .rep-tile-p { font-size: 12.5px; color: var(--muted-foreground); margin: 0; flex: 1; line-height: 1.45; }
    .rep-tile-cta { font-size: 12.5px; font-weight: 700; color: var(--primary); }
    .mono { font-family: 'JetBrains Mono','Consolas',monospace; }
</style>

@code {
    private List<TrdDto>? _trds;
    private bool _verUsuarios;

    protected override async Task OnInitializedAsync() =>
        _trds = (await Trd.ListarTrdAsync()).ToList();

    private void AbrirIndicadores() => Nav.NavigateTo("/reportes/indicadores");
}
